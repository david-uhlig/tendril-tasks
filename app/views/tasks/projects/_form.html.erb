<%# locals: (project_form:) %>
<%= form_with model: project_form,
              builder: Gustwave::FormBuilder,
              url: tasks_projects_path,
              method: :post,
              id: "new-project-form",
              data: { turbo_stream: "true" } do |f| %>
  <div class="p-4 md:p-5 space-y-4">
    <%= render Modal::ParagraphComponent.new(t(".explainer")) %>

    <%= f.text_field :title %>

    <%= render Gustwave::Form::Field.new(:description, form: f) do |field| %>
      <% field.with_control_rich_textarea(spellcheck: false) do |editor| %>
        <% editor.with_header_toolbar(disabled: %i[heading1 heading2 heading3]) %>
      <% end %>
    <% end %>

    <%= render Form::ToggleComponent.new(f, :publish, t(".visibility")) do |toggle| %>
      <% toggle.with_checked_state_text(t(".private")) %>
      <% toggle.with_unchecked_state_text(t(".public")) %>
    <% end %>
  </div>

  <%= render Modal::FooterComponent.new do %>
    <%= render Gustwave::Buttons::Default.new(type: :submit, class: "w-full").with_content(t("forms.create")) %>
  <% end %>
<% end %>
