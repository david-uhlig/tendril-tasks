<%# locals: (preview:, **) %>
<%# Lookbook renders disabled panels too, so this may have no component. %>
<% component = Gustwave::ComponentStatus.component_for_preview(preview.preview_class) %>
<% status = Gustwave::ComponentStatus.for(component) %>

<% if status %>
  <div style="padding:1rem">
    <p><code><%= component.name %></code> is <strong><%= status %></strong>.</p>
    <p><%= Gustwave::ComponentStatus::MEANINGS.fetch(status) %></p>

    <p>
      <%= link_to "How components move from alpha to stable", lookbook_page_path("design", anchor: "component-lifecycle"), style: "text-decoration:underline" %>
    </p>
  </div>
<% end %>
