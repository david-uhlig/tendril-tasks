<%# locals: () %>
<%# On the hero picture, aligned left on wide screens, with the label above the buttons %>
<div class="text-center lg:text-start">
  <div class="sm:flex sm:items-center sm:justify-center sm:gap-x-4 text-center lg:block lg:text-start">
    <%= tag.span t(".view_now"),
                 class: "font-mono text-white mb-4 sm:mb-0 lg:block lg:mb-4" %>

    <div class="flex flex-col sm:flex-row sm:items-center sm:gap-x-4 lg:flex-wrap lg:gap-y-3" role="group">
      <%= render Gustwave::Button
                   .new(tag: :a,
                        href: projects_path,
                        theme: :outline,
                        scheme: :white,
                        size: :lg,
                        class: "mt-4 sm:mt-0")
                   .with_content(t ".interesting_initiatives") %>

      <%= render Gustwave::Button
                   .new(tag: :a,
                        href: tasks_path,
                        size: :lg,
                        class: "mt-4 sm:mt-0")
                   .with_content(t ".variety_of_tasks") %>
    </div>
  </div>
</div>
