<%= render TendrilTasks::Content.new(class: "space-y-16") do %>
  <section>
    <%= render TendrilTasks::Heading.new(
                 tag: :h1,
                 scheme: :level1,
                 class: "text-center") do %>
      <%= render ::Text::Highlight::GradientComponent.new(
        t(".title"),
        highlight: t(".title_highlight")
      ) %>
    <% end %>

    <% paragraphize(t(".hero")).each do |paragraph| %>
      <%= render TendrilTasks::Paragraph.new(class: "mb-6 text-center sm:px-16 xl:px-48") do %>
        <%= paragraph %>
      <% end %>
    <% end %>

    <% if user_signed_in? %>
      <%# CTA to projects and tasks %>
      <%= render "pages/home/cta_when_signed_in" %>
    <% else %>
      <%# CTA with login button %>
      <%= render "pages/home/cta_when_signed_out" %>
    <% end %>
  </section>

  <% if @open_tasks_count.positive? %>
    <%= render "pages/home/stats",
               open_tasks_count: @open_tasks_count,
               initiatives_count: @initiatives_count,
               new_tasks_count: @new_tasks_count %>
  <% end %>

  <% if @recent_tasks.present? %>
    <%= render "pages/home/recent_tasks",
               tasks: @recent_tasks,
               open_tasks_count: @open_tasks_count %>
  <% end %>

  <%= render "pages/home/how_it_works" %>
<% end %>
