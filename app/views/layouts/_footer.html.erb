<%# locals: (data:) %>
<%= render Gustwave::Footer.new(
      class: "mt-auto shadow-inner",
      container_options: { class: "max-w-(--breakpoint-lg) py-6 lg:py-8" }
    ) do %>
  <div class="md:flex md:justify-between">
    <div class="mb-6 md:mb-0">
      <div class="mb-4">
        <%= render Gustwave::Link.new(href: "https://github.com/david-uhlig/tendril-tasks", color: :none, underline: :none, class: "flex items-center gap-2") do %>
          <%= render Gustwave::Svg.new("brand/logo.svg", class: "h-8") %>
          <span class="self-center text-2xl font-semibold whitespace-nowrap dark:text-white">Tendril Tasks</span>
          <%= render Gustwave::Badge.new(TendrilTasks::VERSION, color: :dark, size: :sm, pill: true) %>
        <% end %>
      </div>

      <div class="ms-1.5 me-2 text-gray-500 dark:text-gray-400 font-medium">
        <%= render Gustwave::Icon.new(:github, theme: :solid, size: :sm, class: "inline-flex align-middle") %>
        <%= render Gustwave::Link.new("Fair-Source-Software", href: "https://github.com/david-uhlig/tendril-tasks", color: :none) %>
        <%= t(".attribution") %>
        <%= render Gustwave::Link.new("David Uhlig", href: "https://github.com/david-uhlig/tendril-tasks", color: :none, class: "whitespace-nowrap") %>
      </div>
    </div>

    <%# Sitemap links %>
    <div class="grid grid-cols-2 gap-8 sm:gap-6 sm:grid-cols-3" dir="rtl">
      <%# Legal link block %>
      <% if data.legal.present? %>
        <div dir="ltr">
          <h2 class="mb-6 text-sm font-semibold text-gray-900 uppercase dark:text-white">
            <%= t("footer.link_sections.legal") %>
          </h2>

          <ul class="text-gray-500 dark:text-gray-400 font-medium">
            <% data.legal.each do |slug| %>
              <li class="mb-4 overflow-hidden truncate">
                <%= render Gustwave::Link.new(t("pages.#{slug}.title"), href: legal_path(slug), color: :none) %>
              </li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <% data.sitemap.categories.each do |category| %>
        <div dir="ltr">
          <h2 class="mb-6 text-sm font-semibold text-gray-900 uppercase dark:text-white"><%= category.title %></h2>

          <ul class="text-gray-500 dark:text-gray-400 font-medium space-y-4">
            <% category.links.each do |link| %>
              <li><%= render Gustwave::Link.new(link.title, href: link.safe_href, color: :none) %></li>
            <% end %>
          </ul>
        </div>
      <% end %>
    </div>
  </div>

  <% if data.copyright.present? %>
    <hr class="my-6 border-gray-200 sm:mx-auto dark:border-gray-700 lg:my-8">
    <div class="sm:flex sm:items-center sm:justify-between">
      <span class="text-sm text-gray-500 sm:text-center dark:text-gray-400">
        <%= data.copyright %>
      </span>

      <%# TODO configurable social media icons with links %>
      <div class="flex mt-4 sm:justify-center sm:mt-0">&nbsp;</div>
    </div>
  <% end %>
<% end %>
