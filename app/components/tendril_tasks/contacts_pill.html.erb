<%= render Modal::ToggleButtonComponent.new(color: :none, modal_id: @modal_id, **@options) do %>
  <%= render Gustwave::Badge.new(t(".contacts"),
                                 pill: true,
                                 class: "shrink-0 text-xs font-normal bg-blue-600 text-white px-4 py-1.5 me-3 dark:bg-blue-600 dark:text-white") %>

  <span class="flex gap-2 overflow-hidden shrink truncate">
    <% @coordinators.each do |coordinator| %>
      <span class="flex items-center gap-2 text-sm font-medium">
        <%= render TendrilTasks::Avatar.new(coordinator, size: :xs, tag: :span) %>
        <%= tag.span coordinator.name, class: "dark:text-white truncate" %>
      </span>
    <% end %>
  </span>

  <%#
    The chevron's glyph is 4x8 of its 24px box, as Flowbite's is of its 10px one. The negative margins keep
    Flowbite's 10px layout box, and shrink-[0.42] (10/24) makes it give way on phones as much as Flowbite's does.
  %>
  <%= render Gustwave::Icon.new(:chevron_right, class: "size-6 -m-1.75 ms-0.25 shrink-[0.42] rtl:rotate-180") %>
<% end %>
