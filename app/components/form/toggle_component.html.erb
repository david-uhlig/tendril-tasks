<%= render Form::BaseFieldComponent.new(@form, @attribute, @label) do %>
  <label class="inline-flex items-center cursor-pointer">
    <%= check_box %>
    <%= checked_state_text if checked_state_text? %>
    <%= tag.span **@options %>
    <%= unchecked_state_text if unchecked_state_text? %>
  </label>
<% end %>
