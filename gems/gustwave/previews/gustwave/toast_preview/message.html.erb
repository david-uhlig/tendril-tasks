<%= render Gustwave::Toast.new(class: "block") do |toast| %>
  <div class="flex">
    <%= render Gustwave::Avatar.new(src: "/icon.png", alt: "Ada Lovelace", size: :sm) %>

    <div class="ms-3 text-sm font-normal">
      <span class="mb-1 text-sm font-semibold text-gray-900 dark:text-white">Ada Lovelace</span>

      <div class="mb-2 text-sm font-normal">Hi Grace, thanks for sharing your thoughts on the roadmap.</div>
      <%= render Gustwave::Buttons::Default.new("Reply", tag: :a, href: "#", size: :xs, class: "px-2.5 py-1.5 bg-blue-600 hover:bg-blue-700 dark:bg-blue-500 dark:hover:bg-blue-600") %>
    </div>

    <%= toast.dismiss_button %>
  </div>
<% end %>
