<div class="space-y-4">
  <%= render Gustwave::Toast.new("You have a new message.", status: :info, icon: :bell) %>

  <%= render Gustwave::Toast.new("Your changes were saved.", status: :success) do |toast| %>
    <% toast.with_visual_icon :check_circle, theme: :outline %>
  <% end %>

  <%= render Gustwave::Toast.new("Bonnie Green sent you a message.") do |toast| %>
    <% toast.with_visual_renderable Gustwave::Icon.new(:bell, class: "text-purple-500") %>
  <% end %>
</div>
