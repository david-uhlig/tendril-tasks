<%= render Gustwave::Toast.new(class: "block text-gray-900 dark:text-gray-300") do |toast| %>
  <div class="flex items-center mb-3">
    <span class="mb-1 text-sm font-semibold text-gray-900 dark:text-white">New notification</span>
    <%= toast.dismiss_button %>
  </div>

  <div class="flex items-center">
    <div class="relative inline-block shrink-0">
      <%= render Gustwave::Avatar.new(src: "/icon.png", alt: "Grace Hopper", size: :lg) %>

      <%= render Gustwave::Indicator.new(color: :blue, size: :lg, class: "absolute bottom-0 right-0 w-6 px-0") do %>
        <%= render Gustwave::Icon.new(:messages, theme: :solid, size: :xs, class: "text-white") %>
        <span class="sr-only">Message icon</span>
      <% end %>
    </div>

    <div class="ms-3 text-sm font-normal">
      <div class="text-sm font-semibold text-gray-900 dark:text-white">Grace Hopper</div>
      <div class="text-sm font-normal">commented on your task</div>

      <span class="text-xs font-medium text-blue-600 dark:text-blue-500">a few seconds ago</span>
    </div>
  </div>
<% end %>
