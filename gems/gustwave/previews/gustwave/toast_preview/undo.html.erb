<%= render Gustwave::Toast.new do |toast| %>
  <div class="text-sm font-normal">Task archived.</div>

  <div class="flex items-center ms-auto space-x-2 rtl:space-x-reverse">
    <%= render Gustwave::Link.new("Undo", href: "#", color: :none, class: "text-sm font-medium text-blue-600 p-1.5 hover:bg-blue-100 rounded-lg dark:text-blue-500 dark:hover:bg-gray-700") %>
    <%= toast.dismiss_button %>
  </div>
<% end %>
