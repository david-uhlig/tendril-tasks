<%= render Gustwave::Toast.new(class: "block") do |toast| %>
  <div class="flex">
    <div
      class="
        inline-flex items-center justify-center shrink-0 w-8 h-8 text-blue-500 bg-blue-100 rounded-lg
        dark:text-blue-300 dark:bg-blue-900
      "
    >
      <%= render Gustwave::Icon.new(:refresh, size: :xs) %>
      <span class="sr-only">Refresh icon</span>
    </div>

    <div class="ms-3 text-sm font-normal">
      <span class="mb-1 text-sm font-semibold text-gray-900 dark:text-white">Update available</span>

      <div class="mb-2 text-sm font-normal">A new version of the app is ready to install.</div>

      <div class="grid grid-cols-2 gap-2">
        <div>
          <%= render Gustwave::Buttons::Default.new("Update", tag: :a, href: "#", size: :xs, class: "inline-flex justify-center w-full px-2 py-1.5 bg-blue-600 hover:bg-blue-700 dark:bg-blue-500 dark:hover:bg-blue-600") %>
        </div>

        <div>
          <%= render Gustwave::Buttons::Default.new("Not now", tag: :a, href: "#", size: :xs, color: :light, class: "inline-flex justify-center w-full px-2 py-1.5 dark:bg-gray-600 dark:border-gray-600 dark:hover:bg-gray-700 dark:hover:border-gray-700") %>
        </div>
      </div>
    </div>

    <%= toast.dismiss_button %>
  </div>
<% end %>
