<% modal = Gustwave::Modal.new(id: "popup-modal", size: :sm) %>

<div class="flex justify-center">
  <%= render Gustwave::Buttons::Default.new("Open modal", **modal.trigger_options) %>
</div>

<%= render modal do %>
  <% close_button = Gustwave::Button.for(:inline).new(
       tag.span("Close modal", class: "sr-only"),
       color: :none,
       class: "absolute top-3 end-2.5 text-gray-400 bg-transparent hover:bg-gray-200 hover:text-gray-900 rounded-lg text-sm w-8 h-8 ms-auto inline-flex justify-center items-center dark:hover:bg-gray-600 dark:hover:text-white",
       **modal.trigger_options(action: :hide)
     ) %>

  <% close_button.with_leading_visual_icon(:close, stroke_width: 2, class: "w-6 h-6") %>
  <%= render close_button %>

  <%= render Gustwave::ModalBody.new(class: "text-center") do %>
    <div>
      <%= render Gustwave::Icon.new(:exclamation_circle, size: :"5xl", class: "mx-auto mb-4 text-gray-400 dark:text-gray-200") %>

      <%= render Gustwave::Heading.new("Delete this project?", tag: :h3, size: :none, class: "mb-5 text-lg font-normal text-gray-500 dark:text-gray-400") %>

      <%= render Gustwave::Buttons::Default.new("Yes, delete", color: :red, **modal.trigger_options(action: :hide)) %>
      <%= render Gustwave::Buttons::Default.new("No, cancel", color: :alternative, class: "ms-3", **modal.trigger_options(action: :hide)) %>
    </div>
  <% end %>
<% end %>
