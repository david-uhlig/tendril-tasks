<% modals = [
     Gustwave::Modal.new(id: "small-modal", size: :sm),
     Gustwave::Modal.new(id: "medium-modal", size: :md),
     Gustwave::Modal.new(id: "large-modal", size: :lg),
     Gustwave::Modal.new(id: "extralarge-modal", size: :xl)
   ] %>

<% labels = [ "Small modal", "Default modal", "Large modal", "Extra large modal" ] %>
<% paragraph_counts = [ 2, 2, 2, 6 ] %>

<% sentences = [
     "Please read the terms of service before you continue.",
     "By accepting, you agree to use this service in line with them."
   ] %>

<div class="flex justify-center">
  <div class="block space-y-4 md:flex md:space-y-0 md:space-x-4 rtl:space-x-reverse">
    <% modals.zip(labels).each do |modal, label| %>
      <%= render Gustwave::Buttons::Default.new(label, class: "w-full md:w-auto", **modal.trigger_options) %>
    <% end %>
  </div>
</div>

<% modals.zip(labels, paragraph_counts).each do |modal, label, paragraph_count| %>
  <%= render modal do |component| %>
    <% component.with_header(label, title_options: { class: "font-medium" }) %>

    <% component.with_body do %>
      <% paragraph_count.times do |index| %>
        <%= render Gustwave::Paragraph.new(sentences[index % 2], class: "text-base leading-relaxed") %>
      <% end %>
    <% end %>

    <% component.with_footer do %>
      <%= render Gustwave::Buttons::Default.new("I accept", **modal.trigger_options(action: :hide)) %>
      <%= render Gustwave::Buttons::Default.new("Decline", color: :alternative, **modal.trigger_options(action: :hide)) %>
    <% end %>
  <% end %>
<% end %>
