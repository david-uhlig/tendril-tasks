<% modal = Gustwave::Modal.new(id: "custom-close-modal", size: :sm) %>

<div class="flex justify-center">
  <%= render Gustwave::Buttons::Default.new("Open modal", **modal.trigger_options) %>
</div>

<%= render modal do |component| %>
  <% component.with_header("Delete this project?") do |header| %>
    <% header.with_close_button(text: "Dismiss dialog", class: "text-red-600 hover:text-red-800") %>
  <% end %>

  <% component.with_body(class: "text-center") do %>
    <p class="text-sm text-gray-500 dark:text-gray-400">The close button in the header is customized.</p>
  <% end %>
<% end %>
