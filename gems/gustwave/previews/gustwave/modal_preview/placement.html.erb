<% modals = [
     Gustwave::Modal.new(id: "top-left-modal", placement: :"top-left"),
     Gustwave::Modal.new(id: "top-right-modal", placement: :"top-right"),
     Gustwave::Modal.new(id: "bottom-left-modal", placement: :"bottom-left"),
     Gustwave::Modal.new(id: "bottom-right-modal", placement: :"bottom-right")
   ] %>

<% labels = [ "Top left", "Top right", "Bottom left", "Bottom right" ] %>

<% sentences = [
     "Please read the terms of service before you continue.",
     "By accepting, you agree to use this service in line with them."
   ] %>

<div class="flex justify-center">
  <div class="block space-y-4 md:flex md:space-y-0 md:space-x-4 md:rtl:space-x-reverse">
    <% modals.zip(labels).each do |modal, label| %>
      <%= render Gustwave::Buttons::Default.new(label, class: "w-full md:w-auto", **modal.trigger_options) %>
    <% end %>
  </div>
</div>

<% modals.zip(labels).each do |modal, label| %>
  <%= render modal do |component| %>
    <% component.with_header("#{label} modal", title_options: { class: "font-medium" }) %>

    <% component.with_body do %>
      <% sentences.each do |sentence| %>
        <%= render Gustwave::Paragraph.new(sentence, class: "text-base leading-relaxed") %>
      <% end %>
    <% end %>

    <% component.with_footer do %>
      <%= render Gustwave::Buttons::Default.new("I accept", **modal.trigger_options(action: :hide)) %>
      <%= render Gustwave::Buttons::Default.new("Decline", color: :alternative, **modal.trigger_options(action: :hide)) %>
    <% end %>
  <% end %>
<% end %>
