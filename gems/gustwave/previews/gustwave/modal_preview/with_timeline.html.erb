<% modal = Gustwave::Modal.new(id: "timeline-modal", size: :sm) %>
<% marker_options = { class: "bg-gray-100 -start-3.5 dark:ring-gray-700 dark:bg-gray-600" } %>
<% marker_icon_class = "w-3.5 h-3.5 text-gray-500 dark:text-gray-400" %>
<% title_class = "mb-1 text-lg font-semibold text-gray-900 dark:text-white" %>
<% time_class = "block mb-3 text-sm font-normal leading-none text-gray-500 dark:text-gray-400" %>

<div class="flex justify-center">
  <%= render Gustwave::Buttons::Default.new("Open modal", **modal.trigger_options) %>
</div>

<%= render modal do |component| %>
  <% component.with_header("Changelog", title_options: { class: "text-lg" }) %>

  <% component.with_body do %>
    <div>
      <%= render Gustwave::Timeline.new(class: "dark:border-gray-600 ms-3.5 mb-4 md:mb-5") do |timeline| %>
        <% timeline.with_item(class: "ms-8", marker_options:) do |item| %>
          <% item.with_marker_icon :calendar_week, class: marker_icon_class %>

          <%= render Gustwave::Heading.new(tag: :h3, size: :none, class: "flex items-start #{title_class}") do %>
            Flowbite Application UI v2.0.0 <%= render Gustwave::Badge.new("Latest", size: :sm, class: "ms-3 mr-2") %>
          <% end %>

          <time class="<%= time_class %>">Released on Nov 10th, 2023</time>
          <% download = Gustwave::Buttons::Default.new("Download", color: :alternative, size: :sm) %>
          <% download.with_leading_visual_icon(:download, theme: :solid, class: "w-4 h-4 -mx-0.5") %>

          <%= render download %>
        <% end %>

        <% timeline.with_item(class: "ms-8", marker_options:) do |item| %>
          <% item.with_marker_icon :calendar_week, class: marker_icon_class %>

          <%= render Gustwave::Heading.new("Flowbite Figma v2.8.0", tag: :h3, size: :none, class: title_class) %>
          <time class="<%= time_class %>">Released on Oct 7th, 2023</time>
          <% figma = Gustwave::Buttons::Default.new("Duplicate in Figma", color: :alternative, size: :sm) %>

          <% figma.with_leading_visual_svg(class: "w-3 h-3") do %>
            <svg aria-hidden="true" viewBox="0 0 30 45" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path
                d="M7.50012 45C11.6401 45 15.0002 41.6399 15.0002 37.4999V29.9999H7.50012C3.36009 29.9999 0 33.3599 0 37.4999C0 41.6399 3.36009 45 7.50012 45Z"
                fill="#0ACF83"
              />

              <path
                d="M0 22.5C0 18.36 3.36009 14.9999 7.50012 14.9999H15.0002V29.9999H7.50012C3.36009 30.0001 0 26.64 0 22.5Z"
                fill="#A259FF"
              />

              <path
                d="M0 7.50006C0 3.36006 3.36009 0 7.50012 0H15.0002V14.9999H7.50012C3.36009 14.9999 0 11.6401 0 7.50006Z"
                fill="#F24E1E"
              />

              <path
                d="M15.0002 0H22.4999C26.6399 0 30 3.36006 30 7.50006C30 11.6401 26.6399 14.9999 22.4999 14.9999L15.0002 14.9999V0Z"
                fill="#FF7262"
              />

              <path
                d="M30 22.5C30 26.64 26.6399 30 22.4999 30C18.3599 30 14.9998 26.64 14.9998 22.5C14.9998 18.36 18.3599 14.9999 22.4999 14.9999C26.6399 14.9999 30 18.36 30 22.5Z"
                fill="#1ABCFE"
              />
            </svg>
          <% end %>

          <%= render figma %>
        <% end %>

        <% timeline.with_item(class: "ms-8", marker_options:) do |item| %>
          <% item.with_marker_icon :calendar_week, class: marker_icon_class %>

          <%= render Gustwave::Heading.new("Flowbite Library v1.2.2", tag: :h3, size: :none, class: title_class) %>
          <time class="<%= time_class %>">Released on December 2nd, 2021</time>
        <% end %>
      <% end %>

      <%= render Gustwave::Buttons::Default.new("My downloads", class: "w-full") %>
    </div>
  <% end %>
<% end %>
