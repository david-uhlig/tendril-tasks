<% modal = Gustwave::Modal.new(id: "timeline-modal", size: :sm) %>

<div class="flex justify-center">
  <%= render Gustwave::Buttons::Default.new("Open modal", **modal.trigger_options) %>
</div>

<%= render modal do |component| %>
  <% component.with_header("Changelog", title_options: { class: "text-lg" }) %>

  <% component.with_body(class: "space-y-0") do %>
    <ol class="relative border-s border-gray-200 dark:border-gray-600 ms-3.5 mb-4 md:mb-5">
      <li class="mb-10 ms-8">
        <span
          class="
            absolute flex items-center justify-center w-6 h-6 bg-gray-100 rounded-full -start-3.5 ring-8 ring-white
            dark:ring-gray-700 dark:bg-gray-600
          "
        >
          <%= render Gustwave::Icon.new(:calendar_week, theme: :solid, class: "w-2.5 h-2.5 text-gray-500 dark:text-gray-400") %>
        </span>

        <%= render Gustwave::Heading.new(tag: :h3, size: :none, class: "flex items-start mb-1 text-lg font-semibold text-gray-900 dark:text-white") do %>
          Flowbite Application UI v2.0.0 <%= render Gustwave::Badge.new("Latest", size: :sm, class: "ms-3 mr-2") %>
        <% end %>

        <time class="block mb-3 text-sm font-normal leading-none text-gray-500 dark:text-gray-400">Released on Nov 10th, 2023</time>
        <% download = Gustwave::Buttons::Default.new("Download", color: :alternative, size: :sm, class: "inline-flex items-center") %>
        <% download.with_leading_visual_icon(:download, theme: :solid, class: "w-3 h-3 me-1.5") %>

        <%= render download %>
      </li>

      <li class="mb-10 ms-8">
        <span
          class="
            absolute flex items-center justify-center w-6 h-6 bg-gray-100 rounded-full -start-3.5 ring-8 ring-white
            dark:ring-gray-700 dark:bg-gray-600
          "
        >
          <%= render Gustwave::Icon.new(:calendar_week, theme: :solid, class: "w-2.5 h-2.5 text-gray-500 dark:text-gray-400") %>
        </span>

        <%= render Gustwave::Heading.new("Flowbite Figma v2.8.0", tag: :h3, size: :none, class: "mb-1 text-lg font-semibold text-gray-900 dark:text-white") %>
        <time class="block mb-3 text-sm font-normal leading-none text-gray-500 dark:text-gray-400">Released on Oct 7th, 2023</time>
        <% download = Gustwave::Buttons::Default.new("Download", color: :alternative, size: :sm, class: "inline-flex items-center") %>
        <% download.with_leading_visual_icon(:download, theme: :solid, class: "w-3 h-3 me-1.5") %>

        <%= render download %>
      </li>

      <li class="ms-8">
        <span
          class="
            absolute flex items-center justify-center w-6 h-6 bg-gray-100 rounded-full -start-3.5 ring-8 ring-white
            dark:ring-gray-700 dark:bg-gray-600
          "
        >
          <%= render Gustwave::Icon.new(:calendar_week, theme: :solid, class: "w-2.5 h-2.5 text-gray-500 dark:text-gray-400") %>
        </span>

        <%= render Gustwave::Heading.new("Flowbite Library v1.2.2", tag: :h3, size: :none, class: "mb-1 text-lg font-semibold text-gray-900 dark:text-white") %>
        <time class="block mb-3 text-sm font-normal leading-none text-gray-500 dark:text-gray-400">Released on December 2nd, 2021</time>
      </li>
    </ol>

    <%= render Gustwave::Buttons::Default.new("My downloads", class: "w-full") %>
  <% end %>
<% end %>
