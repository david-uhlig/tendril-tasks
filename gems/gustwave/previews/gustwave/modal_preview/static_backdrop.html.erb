<% modal = Gustwave::Modal.new(id: "static-modal", backdrop: :static) %>

<%= render Gustwave::Buttons::Default.new("Open modal", **modal.trigger_options(id: "static-modal-toggle")) %>

<%= render modal do |component| %>
  <% component.with_header("Static modal") %>

  <% component.with_body do %>
    <%= render Gustwave::Paragraph.new("Please read the terms of service before you continue.", class: "text-base leading-relaxed") %>
    <%= render Gustwave::Paragraph.new("By accepting, you agree to use this service in line with them.", class: "text-base leading-relaxed") %>
  <% end %>

  <% component.with_footer do %>
    <%= render Gustwave::Buttons::Default.new("I accept", **modal.trigger_options(action: :hide)) %>
    <%= render Gustwave::Buttons::Default.new("Decline", color: :alternative, **modal.trigger_options(action: :hide)) %>
  <% end %>
<% end %>
