<% modal = Gustwave::Modal.new(id: "crypto-modal", size: :sm) %>

<div class="flex justify-center">
  <% trigger = Gustwave::Buttons::Default.new("Connect wallet", color: :alternative, class: "dark:text-white", **modal.trigger_options) %>
  <% trigger.with_leading_visual_icon(:wallet, theme: :solid, class: "h-4 w-4 me-0.5") %>

  <%= render trigger %>
</div>

<%= render modal do |component| %>
  <% component.with_header("Connect wallet", title_options: { class: "text-lg" }) %>

  <% component.with_body do %>
    <div>
      <%= render Gustwave::Paragraph.new("Connect with one of our available wallet providers or create a new one.", class: "text-sm font-normal") %>

      <ul class="my-4 space-y-3">
        <li>
          <a
            href="#metamask"
            class="
              flex items-center p-3 text-base font-bold text-gray-900 rounded-lg bg-gray-50 hover:bg-gray-100 group
              hover:shadow dark:bg-gray-600 dark:hover:bg-gray-500 dark:text-white
            "
          >
            <%= render Gustwave::Icon.new(:wallet, theme: :solid, class: "h-5 w-5 -mx-0.5") %>
            <span class="flex-1 ms-3 whitespace-nowrap">MetaMask</span>
            <%= render Gustwave::Badge.new("Popular", color: :dark, size: :xs, class: "ms-3 px-2 text-gray-500 bg-gray-200 dark:bg-gray-700 dark:text-gray-400") %>
          </a>
        </li>

        <li>
          <a
            href="#coinbase"
            class="
              flex items-center p-3 text-base font-bold text-gray-900 rounded-lg bg-gray-50 hover:bg-gray-100 group
              hover:shadow dark:bg-gray-600 dark:hover:bg-gray-500 dark:text-white
            "
          >
            <%= render Gustwave::Icon.new(:wallet, theme: :solid, class: "h-7 w-7 -m-1") %>
            <span class="flex-1 ms-3 whitespace-nowrap">Coinbase Wallet</span>
          </a>
        </li>

        <li>
          <a
            href="#opera"
            class="
              flex items-center p-3 text-base font-bold text-gray-900 rounded-lg bg-gray-50 hover:bg-gray-100 group
              hover:shadow dark:bg-gray-600 dark:hover:bg-gray-500 dark:text-white
            "
          >
            <%= render Gustwave::Icon.new(:wallet, theme: :solid, class: "h-7 w-7 -m-1") %>
            <span class="flex-1 ms-3 whitespace-nowrap">Opera Wallet</span>
          </a>
        </li>

        <li>
          <a
            href="#walletconnect"
            class="
              flex items-center p-3 text-base font-bold text-gray-900 rounded-lg bg-gray-50 hover:bg-gray-100 group
              hover:shadow dark:bg-gray-600 dark:hover:bg-gray-500 dark:text-white
            "
          >
            <%= render Gustwave::Icon.new(:wallet, theme: :solid, class: "h-7 w-7 -m-1") %>
            <span class="flex-1 ms-3 whitespace-nowrap">WalletConnect</span>
          </a>
        </li>

        <li>
          <a
            href="#fortmatic"
            class="
              flex items-center p-3 text-base font-bold text-gray-900 rounded-lg bg-gray-50 hover:bg-gray-100 group
              hover:shadow dark:bg-gray-600 dark:hover:bg-gray-500 dark:text-white
            "
          >
            <%= render Gustwave::Icon.new(:wallet, theme: :solid, class: "h-5 w-5 -mx-0.5") %>
            <span class="flex-1 ms-3 whitespace-nowrap">Fortmatic</span>
          </a>
        </li>
      </ul>

      <div>
        <%= render Gustwave::Link.new(color: :none, class: "inline-flex items-center text-xs font-normal text-gray-500 hover:underline dark:text-gray-400") do %>
          <%= render Gustwave::Icon.new(:question_circle, class: "w-3 h-3 me-2") %> Why do I need to connect with my
          wallet?
        <% end %>
      </div>
    </div>
  <% end %>
<% end %>
