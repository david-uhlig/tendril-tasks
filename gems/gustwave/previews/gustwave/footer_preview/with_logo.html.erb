<%= render Gustwave::Footer.new(class: "rounded-lg shadow-sm m-4", container_options: { class: "md:py-8" }) do %>
  <div class="sm:flex sm:items-center sm:justify-between">
    <%= render Gustwave::Link.new(href: "#", color: :none, underline: :none, class: "flex items-center mb-4 sm:mb-0 space-x-3 rtl:space-x-reverse") do %>
      <%= render Gustwave::Icon.new(:rocket, theme: :solid, position: :standalone, class: "size-8 text-blue-700 dark:text-blue-500") %>
      <span class="self-center text-2xl font-semibold whitespace-nowrap dark:text-white">Flowbite</span>
    <% end %>
    <ul class="flex flex-wrap items-center mb-6 text-sm font-medium text-gray-500 sm:mb-0 dark:text-gray-400">
      <li><%= render Gustwave::Link.new("About", href: "#", color: :none, class: "me-4 md:me-6") %></li>
      <li><%= render Gustwave::Link.new("Privacy Policy", href: "#", color: :none, class: "me-4 md:me-6") %></li>
      <li><%= render Gustwave::Link.new("Licensing", href: "#", color: :none, class: "me-4 md:me-6") %></li>
      <li><%= render Gustwave::Link.new("Contact", href: "#", color: :none) %></li>
    </ul>
  </div>
  <%= render Gustwave::HorizontalLine.new(class: "my-6 sm:mx-auto lg:my-8") %>
  <span class="block text-sm text-gray-500 sm:text-center dark:text-gray-400">© 2023 <%= render Gustwave::Link.new("Flowbite™", href: "#", color: :none, class: "font-normal") %>. All Rights Reserved.</span>
<% end %>
