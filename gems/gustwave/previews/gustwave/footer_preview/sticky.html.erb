<div class="p-4 pb-24">
  <%= render Gustwave::Paragraph.new("The footer stays at the bottom of the viewport while the page scrolls.") %>
  <%= render Gustwave::Paragraph.new("Scroll down to see the page content pass behind it.") %>
  <%= render Gustwave::Paragraph.new("The bottom padding keeps the last paragraph clear of the footer.") %>
</div>

<%= render Gustwave::Footer.new(sticky: true, container_options: { class: "max-w-none md:flex md:items-center md:justify-between md:p-6" }) do %>
  <span class="text-sm text-gray-500 sm:text-center dark:text-gray-400">© 2023 <%= render Gustwave::Link.new("Flowbite™", href: "#", color: :none, class: "font-normal") %>. All Rights Reserved.</span>

  <ul class="flex flex-wrap items-center mt-3 text-sm font-medium text-gray-500 dark:text-gray-400 sm:mt-0">
    <li><%= render Gustwave::Link.new("About", href: "#", color: :none, class: "me-4 md:me-6") %></li>
    <li><%= render Gustwave::Link.new("Privacy Policy", href: "#", color: :none, class: "me-4 md:me-6") %></li>
    <li><%= render Gustwave::Link.new("Licensing", href: "#", color: :none, class: "me-4 md:me-6") %></li>
    <li><%= render Gustwave::Link.new("Contact", href: "#", color: :none) %></li>
  </ul>
<% end %>
