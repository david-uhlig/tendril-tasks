<%= render Gustwave::Footer.new(container_options: { class: "py-6 lg:py-8" }) do %>
  <div class="md:flex md:justify-between">
    <div class="mb-6 md:mb-0">
      <%= render Gustwave::Link.new(href: "#", color: :none, underline: :none, class: "flex items-center") do %>
        <%= render Gustwave::Icon.new(:rocket, theme: :solid, position: :standalone, class: "size-8 me-3 text-blue-700 dark:text-blue-500") %>
        <span class="self-center text-2xl font-semibold whitespace-nowrap dark:text-white">Flowbite</span>
      <% end %>
    </div>

    <div class="grid grid-cols-2 gap-8 sm:gap-6 sm:grid-cols-3">
      <div>
        <%= render Gustwave::Heading.new("Resources", tag: :h2, size: :none, class: "mb-6 text-sm font-semibold uppercase text-gray-900 dark:text-white") %>

        <ul class="text-gray-500 dark:text-gray-400 font-medium">
          <li class="mb-4"><%= render Gustwave::Link.new("Flowbite", href: "#", color: :none) %></li>
          <li><%= render Gustwave::Link.new("Tailwind CSS", href: "#", color: :none) %></li>
        </ul>
      </div>

      <div>
        <%= render Gustwave::Heading.new("Follow us", tag: :h2, size: :none, class: "mb-6 text-sm font-semibold uppercase text-gray-900 dark:text-white") %>

        <ul class="text-gray-500 dark:text-gray-400 font-medium">
          <li class="mb-4"><%= render Gustwave::Link.new("Github", href: "#", color: :none) %></li>
          <li><%= render Gustwave::Link.new("Discord", href: "#", color: :none) %></li>
        </ul>
      </div>

      <div>
        <%= render Gustwave::Heading.new("Legal", tag: :h2, size: :none, class: "mb-6 text-sm font-semibold uppercase text-gray-900 dark:text-white") %>

        <ul class="text-gray-500 dark:text-gray-400 font-medium">
          <li class="mb-4"><%= render Gustwave::Link.new("Privacy Policy", href: "#", color: :none) %></li>
          <li><%= render Gustwave::Link.new("Terms & Conditions", href: "#", color: :none) %></li>
        </ul>
      </div>
    </div>
  </div>

  <%= render Gustwave::HorizontalLine.new(class: "my-6 sm:mx-auto lg:my-8") %>

  <div class="sm:flex sm:items-center sm:justify-between">
    <span class="text-sm text-gray-500 sm:text-center dark:text-gray-400">© 2023 <%= render Gustwave::Link.new("Flowbite™", href: "#", color: :none, class: "font-normal") %>. All Rights Reserved.</span>

    <div class="flex mt-4 sm:justify-center sm:mt-0">
      <% [[:facebook, "Facebook page", ""], [:discord, "Discord community", "ms-5"], [:twitter, "Twitter page", "ms-5"], [:github, "GitHub account", "ms-5"], [:dribbble, "Dribbble account", "ms-5"]].each do |icon, label, spacing| %>
        <%= render Gustwave::Link.new(href: "#", color: :none, underline: :none, class: "text-gray-500 hover:text-gray-900 dark:hover:text-white #{spacing}") do %>
          <%= render Gustwave::Icon.new(icon, theme: :solid, class: "size-5 -m-0.5") %>
          <span class="sr-only"><%= label %></span>
        <% end %>
      <% end %>
    </div>
  </div>
<% end %>
