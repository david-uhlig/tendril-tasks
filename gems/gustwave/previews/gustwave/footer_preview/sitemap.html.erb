<%= render Gustwave::Footer.new(container_options: { class: "p-0" }) do %>
  <div class="grid grid-cols-2 gap-8 px-4 py-6 lg:py-8 md:grid-cols-4">
    <div>
      <%= render Gustwave::Heading.new("Company", tag: :h2, size: :none, class: "mb-6 text-sm font-semibold uppercase text-gray-900 dark:text-white") %>
      <ul class="text-gray-500 dark:text-gray-400 font-medium">
        <li class="mb-4"><%= render Gustwave::Link.new("About", href: "#", color: :none) %></li>
        <li class="mb-4"><%= render Gustwave::Link.new("Careers", href: "#", color: :none) %></li>
        <li class="mb-4"><%= render Gustwave::Link.new("Brand Center", href: "#", color: :none) %></li>
        <li class="mb-4"><%= render Gustwave::Link.new("Blog", href: "#", color: :none) %></li>
      </ul>
    </div>
    <div>
      <%= render Gustwave::Heading.new("Help center", tag: :h2, size: :none, class: "mb-6 text-sm font-semibold uppercase text-gray-900 dark:text-white") %>
      <ul class="text-gray-500 dark:text-gray-400 font-medium">
        <li class="mb-4"><%= render Gustwave::Link.new("Discord Server", href: "#", color: :none) %></li>
        <li class="mb-4"><%= render Gustwave::Link.new("Twitter", href: "#", color: :none) %></li>
        <li class="mb-4"><%= render Gustwave::Link.new("Facebook", href: "#", color: :none) %></li>
        <li class="mb-4"><%= render Gustwave::Link.new("Contact Us", href: "#", color: :none) %></li>
      </ul>
    </div>
    <div>
      <%= render Gustwave::Heading.new("Legal", tag: :h2, size: :none, class: "mb-6 text-sm font-semibold uppercase text-gray-900 dark:text-white") %>
      <ul class="text-gray-500 dark:text-gray-400 font-medium">
        <li class="mb-4"><%= render Gustwave::Link.new("Privacy Policy", href: "#", color: :none) %></li>
        <li class="mb-4"><%= render Gustwave::Link.new("Licensing", href: "#", color: :none) %></li>
        <li class="mb-4"><%= render Gustwave::Link.new("Terms & Conditions", href: "#", color: :none) %></li>
      </ul>
    </div>
    <div>
      <%= render Gustwave::Heading.new("Download", tag: :h2, size: :none, class: "mb-6 text-sm font-semibold uppercase text-gray-900 dark:text-white") %>
      <ul class="text-gray-500 dark:text-gray-400 font-medium">
        <li class="mb-4"><%= render Gustwave::Link.new("iOS", href: "#", color: :none) %></li>
        <li class="mb-4"><%= render Gustwave::Link.new("Android", href: "#", color: :none) %></li>
        <li class="mb-4"><%= render Gustwave::Link.new("Windows", href: "#", color: :none) %></li>
        <li class="mb-4"><%= render Gustwave::Link.new("MacOS", href: "#", color: :none) %></li>
      </ul>
    </div>
  </div>
  <div class="px-4 py-6 bg-gray-100 dark:bg-gray-700 md:flex md:items-center md:justify-between">
    <span class="text-sm text-gray-500 dark:text-gray-300 sm:text-center">© 2023 <%= render Gustwave::Link.new("Flowbite™", href: "#", color: :none, class: "font-normal") %>. All Rights Reserved.</span>
    <div class="flex mt-4 sm:justify-center md:mt-0 space-x-5 rtl:space-x-reverse">
      <% [[:facebook, "Facebook page"], [:discord, "Discord community"], [:twitter, "Twitter page"], [:github, "GitHub account"], [:dribbble, "Dribbble account"]].each do |icon, label| %>
        <%= render Gustwave::Link.new(href: "#", color: :none, underline: :none, class: "text-gray-400 hover:text-gray-900 dark:hover:text-white") do %>
          <%= render Gustwave::Icon.new(icon, theme: :solid, class: "w-4 h-4") %>
          <span class="sr-only"><%= label %></span>
        <% end %>
      <% end %>
    </div>
  </div>
<% end %>
