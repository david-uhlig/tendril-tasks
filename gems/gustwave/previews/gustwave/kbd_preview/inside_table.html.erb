<div class="relative overflow-x-auto">
  <%= render Gustwave::Table.new(class: "w-full text-sm text-left rtl:text-right text-gray-500 dark:text-gray-400") do |table| %>
    <% table.with_head do |head| %>
      <% head.with_column "Key" %>
      <% head.with_column "Description" %>
    <% end %>

    <% table.with_body do |body| %>
      <% body.with_row class: "dark:bg-gray-900" do |row| %>
        <% row.with_cell_th class: "text-gray-500 dark:text-gray-400" do %>
          <%= render Gustwave::Kbd.new("Shift") %>
          <span class="mx-2">or</span>
          <%= render Gustwave::Kbd.new("Tab") %>
        <% end %>

        <% row.with_cell_td "Navigates to interactive elements" %>
      <% end %>

      <% body.with_row class: "dark:bg-gray-900" do |row| %>
        <% row.with_cell_th class: "text-gray-500 dark:text-gray-400" do %>
          <%= render Gustwave::Kbd.new("Enter") %>
          <span class="mx-2">or</span>
          <%= render Gustwave::Kbd.new("Spacebar", class: "px-4") %>
        <% end %>

        <% row.with_cell_td "Activates buttons with both keys" %>
      <% end %>

      <% body.with_row class: "border-b-0 dark:bg-gray-900" do |row| %>
        <% row.with_cell_th class: "inline-flex items-center text-gray-500 dark:text-gray-400" do %>
          <%= render Gustwave::Kbd.new(class: "me-1") do %>
            <%= render Gustwave::Icon.new(:caret_up, theme: :solid, size: :xs, class: "-m-0.75", aria: { hidden: true }) %>
            <span class="sr-only">Arrow key up</span>
          <% end %>

          <%= render Gustwave::Kbd.new do %>
            <%= render Gustwave::Icon.new(:caret_down, theme: :solid, size: :xs, class: "-m-0.75", aria: { hidden: true }) %>
            <span class="sr-only">Arrow key down</span>
          <% end %>

          <span class="mx-2">or</span>

          <%= render Gustwave::Kbd.new(class: "rtl:rotate-180 me-1") do %>
            <%= render Gustwave::Icon.new(:caret_left, theme: :solid, size: :xs, class: "-m-0.75", aria: { hidden: true }) %>
            <span class="sr-only">Arrow key left</span>
          <% end %>

          <%= render Gustwave::Kbd.new(class: "rtl:rotate-180") do %>
            <%= render Gustwave::Icon.new(:caret_right, theme: :solid, size: :xs, class: "-m-0.75", aria: { hidden: true }) %>
            <span class="sr-only">Arrow key right</span>
          <% end %>
        <% end %>

        <% row.with_cell_td "Chooses and activates the previous or next tab" %>
      <% end %>
    <% end %>
  <% end %>
</div>
