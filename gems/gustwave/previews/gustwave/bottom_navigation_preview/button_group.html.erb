<%= render Gustwave::BottomNavigation.new(label_display: :tooltip) do |navigation| %>
  <div class="w-full">
    <div class="grid max-w-xs grid-cols-3 gap-1 p-1 mx-auto my-2 bg-gray-100 rounded-lg dark:bg-gray-600" role="group">
      <button
        type="button"
        class="
          px-5 py-1.5 text-xs font-medium text-gray-900 hover:bg-gray-200 dark:text-white dark:hover:bg-gray-700
          rounded-lg
        "
      >
        New
      </button>

      <button
        type="button"
        class="px-5 py-1.5 text-xs font-medium text-white bg-gray-900 dark:bg-gray-300 dark:text-gray-900 rounded-lg"
      >
        Popular
      </button>

      <button
        type="button"
        class="
          px-5 py-1.5 text-xs font-medium text-gray-900 hover:bg-gray-200 dark:text-white dark:hover:bg-gray-700
          rounded-lg
        "
      >
        Following
      </button>
    </div>
  </div>

  <% navigation.with_item_button "Home", icon: :home %>
  <% navigation.with_item_button "Bookmark", icon: :bookmark %>
  <% navigation.with_item_button "New post", icon: :file_circle_plus %>
  <% navigation.with_item_button "Search", icon: :search %>
  <% navigation.with_item_button "Settings", icon: :cog %>
<% end %>
