<%= render Gustwave::Timeline.new(class: "text-gray-500 dark:text-gray-400") do |timeline| %>
  <% timeline.with_item(marker_options: { class: "w-8 h-8 -start-4 ring-4 bg-green-200 dark:bg-green-900" }) do |item| %>
    <% item.with_marker_icon :check, theme: :outline, class: "size-5.25 text-green-500 dark:text-green-400" %>
    <h3 class="font-medium leading-tight">Personal Info</h3>
    <p class="text-sm">Step details here</p>
  <% end %>

  <% timeline.with_item(marker_options: { class: "w-8 h-8 -start-4 ring-4 bg-gray-100 dark:bg-gray-700" }) do |item| %>
    <% item.with_marker_icon :profile_card, class: "size-4.25 text-gray-500 dark:text-gray-400" %>
    <h3 class="font-medium leading-tight">Account Info</h3>
    <p class="text-sm">Step details here</p>
  <% end %>

  <% timeline.with_item(marker_options: { class: "w-8 h-8 -start-4 ring-4 bg-gray-100 dark:bg-gray-700" }) do |item| %>
    <% item.with_marker_icon :clipboard_list, class: "size-4.25 text-gray-500 dark:text-gray-400" %>
    <h3 class="font-medium leading-tight">Review</h3>
    <p class="text-sm">Step details here</p>
  <% end %>

  <% timeline.with_item(marker_options: { class: "w-8 h-8 -start-4 ring-4 bg-gray-100 dark:bg-gray-700" }) do |item| %>
    <% item.with_marker_icon :clipboard_check, class: "size-4.25 text-gray-500 dark:text-gray-400" %>
    <h3 class="font-medium leading-tight">Confirmation</h3>
    <p class="text-sm">Step details here</p>
  <% end %>
<% end %>
