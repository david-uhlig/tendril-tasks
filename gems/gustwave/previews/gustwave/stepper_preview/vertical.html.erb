<%= render Gustwave::Stepper.new(style: :vertical) do |stepper| %>
  <% stepper.with_step("User info", state: :complete) { |step| step.with_icon :check } %>
  <% stepper.with_step("Account info", state: :complete) { |step| step.with_icon :check } %>
  <% stepper.with_step("Social accounts", state: :current) { |step| step.with_icon :arrow_right, class: "rtl:rotate-180" } %>
  <% stepper.with_step("Review") %>
  <% stepper.with_step("Confirmation") %>
<% end %>
