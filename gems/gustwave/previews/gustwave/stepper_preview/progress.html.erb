<%= render Gustwave::Stepper.new(style: :progress) do |stepper| %>
  <% stepper.with_step("Personal info", state: :complete) { |step| step.with_icon :check, class: "size-5.25 lg:size-6" } %>
  <% stepper.with_step("Account info") { |step| step.with_icon :profile_card, theme: :solid } %>
  <% stepper.with_step("Confirmation") { |step| step.with_icon :clipboard_check, theme: :solid } %>
<% end %>
