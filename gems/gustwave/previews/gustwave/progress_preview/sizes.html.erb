<div id="progress-small" class="mb-1 text-base font-medium dark:text-white">Small</div>
<%= render Gustwave::Progress.new(45, size: :sm, class: "mb-4", aria: { labelledby: "progress-small" }) %>

<div id="progress-default" class="mb-1 text-base font-medium dark:text-white">Default</div>
<%= render Gustwave::Progress.new(45, class: "mb-4", aria: { labelledby: "progress-default" }) %>

<div id="progress-large" class="mb-1 text-lg font-medium dark:text-white">Large</div>
<%= render Gustwave::Progress.new(45, size: :lg, class: "mb-4", aria: { labelledby: "progress-large" }) %>

<div id="progress-extra-large" class="mb-1 text-lg font-medium dark:text-white">Extra Large</div>
<%= render Gustwave::Progress.new(45, size: :xl, aria: { labelledby: "progress-extra-large" }) %>
