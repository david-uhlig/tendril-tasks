<%= render Gustwave::Timeline.new do |timeline| %>
  <% timeline.with_item do |item| %>
    <% item.with_marker_icon :calendar_month %>
    <% item.with_date "Released on January 13th, 2022" %>

    <% item.with_title(class: "flex items-center mb-1") do %>
      Flowbite Application UI v2.0.0 <%= render Gustwave::Badge.new("Latest", class: "ms-3") %>
    <% end %>

    <% item.with_body "Get access to over 20+ pages including a dashboard layout, charts, kanban board, calendar, and pre-order E-commerce & Marketing pages." %>

    <%= render Gustwave::Buttons::Default.new(tag: :a, href: "#", color: :alternative, size: :sm) do |button| %>
      <% button.with_leading_visual_icon :download %> Download ZIP
    <% end %>
  <% end %>

  <% timeline.with_item do |item| %>
    <% item.with_marker_icon :calendar_month %>
    <% item.with_date "Released on December 7th, 2021" %>
    <% item.with_title "Flowbite Figma v1.3.0" %>
    <% item.with_body "All of the pages and components are first designed in Figma and we keep a parity between the two versions even as we update the project." %>
  <% end %>

  <% timeline.with_item do |item| %>
    <% item.with_marker_icon :calendar_month %>
    <% item.with_date "Released on December 2nd, 2021" %>
    <% item.with_title "Flowbite Library v1.2.2" %>
    <% item.with_body "Get started with dozens of web components and interactive elements built on top of Tailwind CSS." %>
  <% end %>
<% end %>
