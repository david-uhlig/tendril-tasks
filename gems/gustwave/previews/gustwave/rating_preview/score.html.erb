<div class="flex items-center mb-5">
  <%= render Gustwave::Badge.new("8.7", size: :sm, class: "p-1.5 font-semibold dark:bg-blue-200 dark:text-blue-800") %>
  <%= render Gustwave::Paragraph.new("Excellent", class: "ms-2 font-medium text-gray-900 dark:text-white") %>

  <span class="w-1 h-1 mx-2 bg-gray-900 rounded-full dark:bg-gray-500"></span>
  <%= render Gustwave::Paragraph.new("376 reviews", class: "text-sm font-medium text-gray-500 dark:text-gray-400") %>
  <%= render Gustwave::Link.new("Read all reviews", href: "#", class: "ms-auto text-sm") %>
</div>

<div class="gap-8 sm:grid sm:grid-cols-2">
  <% [
    [ [ "Staff", 8.8 ], [ "Comfort", 8.9 ], [ "Free WiFi", 8.8 ], [ "Facilities", 5.4 ] ],
    [ [ "Value for money", 8.9 ], [ "Cleanliness", 7.0 ], [ "Location", 8.9 ] ]
  ].each do |column| %>
    <div>
      <% column.each_with_index do |(category, score), index| %>
        <dl>
          <dt id="score-<%= category.parameterize %>" class="text-sm font-medium text-gray-500 dark:text-gray-400">
            <%= category %>
          </dt>

          <dd class="<%= class_names("flex items-center", "mb-3" => index < column.size - 1) %>">
            <%= render Gustwave::Progress.new(
              score * 10,
              class: "me-2 rounded-sm",
              fill_options: { class: "rounded-sm" },
              aria: { labelledby: "score-#{category.parameterize}" }
            ) %>

            <span class="text-sm font-medium text-gray-500 dark:text-gray-400"><%= format("%.1f", score) %></span>
          </dd>
        </dl>
      <% end %>
    </div>
  <% end %>
</div>
