<%= render Gustwave::Rating.new(4.95, class: "mb-2") do %>
  <%= render Gustwave::Paragraph.new("4.95", class: "ms-2 text-sm font-medium text-gray-500 dark:text-gray-400") %>
  <%= render Gustwave::Paragraph.new("out of", class: "ms-1 text-sm font-medium text-gray-500 dark:text-gray-400") %>
  <%= render Gustwave::Paragraph.new("5", class: "ms-1 text-sm font-medium text-gray-500 dark:text-gray-400") %>
<% end %>

<%= render Gustwave::Paragraph.new("1,745 global ratings", class: "text-sm font-medium text-gray-500 dark:text-gray-400") %>

<% [ [ 5, 70 ], [ 4, 17 ], [ 3, 8 ], [ 2, 4 ], [ 1, 1 ] ].each do |stars, percent| %>
  <div class="flex items-center mt-4">
    <%= render Gustwave::Link.new("#{stars} star", href: "#", class: "text-sm") %>

    <div class="w-2/4 h-5 mx-4 bg-gray-200 rounded-sm dark:bg-gray-700">
      <div class="h-5 bg-yellow-300 rounded-sm" style="width: <%= percent %>%"></div>
    </div>

    <span class="text-sm font-medium text-gray-500 dark:text-gray-400"><%= percent %>%</span>
  </div>
<% end %>
