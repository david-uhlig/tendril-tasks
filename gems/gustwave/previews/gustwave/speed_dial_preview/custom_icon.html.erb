  <%= render Gustwave::SpeedDials::Action.new("Edit", label_display: :outside) do |action| %>
    <% action.with_visual_icon :edit, theme: :outline %>
  <% end %>

  <%= render Gustwave::SpeedDials::Action.new("Edit", label_display: :outside, icon: :edit) %>
</div>
