<% drawer = Gustwave::Drawer.new(id: "custom-close-drawer", placement: :right) %>

<div class="flex justify-center py-32">
  <%= render Gustwave::Buttons::Default.new("Show drawer", **drawer.trigger_options) %>
</div>

<%= render drawer do |d| %>
  <% d.with_header("Info", icon: :info_circle) do |header| %>
    <% header.with_close_button(text: "Dismiss drawer", class: "text-red-600 hover:text-red-800") %>
  <% end %>

  <p class="mb-6 text-sm text-gray-500 dark:text-gray-400">
    The close button in the header is customized.
  </p>
<% end %>
