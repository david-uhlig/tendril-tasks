<%= render Gustwave::Jumbotron.new(centered: true) do %>
  <%= render Gustwave::Heading.new("We invest in the world’s potential", tag: :h1, size: :"2xl", responsive: true, class: "mb-4 tracking-tight leading-none") %>
  <%= render Gustwave::Paragraph.new("Here at Flowbite we focus on markets where technology, innovation, and capital can unlock long-term value and drive economic growth.", class: "mb-8 text-lg font-normal lg:text-xl sm:px-16 lg:px-48") %>

  <div class="flex flex-col space-y-4 sm:flex-row sm:justify-center sm:space-y-0">
    <%= render Gustwave::Buttons::Default.new("Get started", tag: :a, href: "#", size: :lg, class: "justify-center") do |button| %>
      <% button.with_trailing_visual_icon :arrow_right %>
    <% end %>

    <%= render Gustwave::Buttons::Default.new("Learn more", tag: :a, href: "#", color: :alternative, size: :lg, class: "sm:ms-4 text-sm") %>
  </div>
<% end %>
