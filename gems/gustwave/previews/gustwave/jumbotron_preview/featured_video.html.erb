<%= render Gustwave::Jumbotron.new(container_options: { class: "grid lg:grid-cols-2 gap-8 lg:gap-16" }) do %>
  <div class="flex flex-col justify-center">
    <%= render Gustwave::Heading.new("We invest in the world’s potential", tag: :h1, size: :"2xl", responsive: true, class: "mb-4 tracking-tight leading-none") %>
    <%= render Gustwave::Paragraph.new("Here at Flowbite we focus on markets where technology, innovation, and capital can unlock long-term value and drive economic growth.", class: "mb-8 text-lg font-normal lg:text-xl") %>
    <div class="flex flex-col space-y-4 sm:flex-row sm:space-y-0">
      <%= render Gustwave::Buttons::Default.new("Get started", tag: :a, href: "#", size: :lg) do |button| %>
        <% button.with_trailing_visual_icon :arrow_right %>
      <% end %>
      <%= render Gustwave::Buttons::Default.new("Learn more", tag: :a, href: "#", color: :alternative, size: :lg, class: "sm:ms-4") %>
    </div>
  </div>
  <div>
    <iframe class="mx-auto w-full lg:max-w-xl h-64 rounded-lg sm:h-96 shadow-xl" src="https://www.youtube.com/embed/KaLxCiilHns" title="YouTube video player" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
  </div>
<% end %>
