<%= render Gustwave::Jumbotron.new do %>
  <%= render Gustwave::Card.new(class: "max-w-none bg-gray-50 shadow-none mb-8", body_options: { class: "p-8 md:p-12" }) do %>
    <%= render Gustwave::Badge.new("Tutorial", tag: :a, href: "#", class: "rounded-md mb-2 dark:bg-gray-700 dark:text-blue-400") do |badge| %>
      <% badge.with_leading_visual_icon :video_camera, class: "w-2.5 h-2.5 me-1.5" %>
    <% end %>
    <%= render Gustwave::Heading.new("How to quickly deploy a static website", tag: :h1, class: "text-3xl md:text-5xl font-extrabold mb-2") %>
    <%= render Gustwave::Paragraph.new("Static websites are now used to bootstrap lots of websites and are becoming the basis for a variety of tools that even influence both web designers and developers.", class: "text-lg mb-6") %>
    <%= render Gustwave::Buttons::Default.new("Read more", tag: :a, href: "#") do |button| %>
      <% button.with_trailing_visual_icon :arrow_right %>
    <% end %>
  <% end %>
  <div class="grid md:grid-cols-2 gap-8">
    <%= render Gustwave::Card.new(class: "max-w-none bg-gray-50 shadow-none", body_options: { class: "p-8 md:p-12" }) do %>
      <%= render Gustwave::Badge.new("Design", tag: :a, href: "#", color: :green, class: "rounded-md mb-2 dark:bg-gray-700 dark:text-green-400") do |badge| %>
        <% badge.with_leading_visual_icon :palette, class: "w-2.5 h-2.5 me-1.5" %>
      <% end %>
      <%= render Gustwave::Heading.new("Start with Flowbite Design System", tag: :h2, class: "text-3xl font-extrabold mb-2") %>
      <%= render Gustwave::Paragraph.new("Static websites are now used to bootstrap lots of websites and are becoming the basis for a variety of tools that even influence both web designers and developers.", class: "text-lg mb-4") %>
      <%= render Gustwave::Link.new(href: "#", class: "text-lg inline-flex items-center") do %>
        Read more
        <%= render Gustwave::Icon.new(:arrow_right, class: "w-3.5 h-3.5 ms-2 rtl:rotate-180") %>
      <% end %>
    <% end %>
    <%= render Gustwave::Card.new(class: "max-w-none bg-gray-50 shadow-none", body_options: { class: "p-8 md:p-12" }) do %>
      <%= render Gustwave::Badge.new("Code", tag: :a, href: "#", color: :purple, class: "rounded-md mb-2 dark:bg-gray-700 dark:text-purple-400") do |badge| %>
        <% badge.with_leading_visual_icon :code, class: "w-2.5 h-2.5 me-1.5" %>
      <% end %>
      <%= render Gustwave::Heading.new("Best react libraries around the web", tag: :h2, class: "text-3xl font-extrabold mb-2") %>
      <%= render Gustwave::Paragraph.new("Static websites are now used to bootstrap lots of websites and are becoming the basis for a variety of tools that even influence both web designers and developers.", class: "text-lg mb-4") %>
      <%= render Gustwave::Link.new(href: "#", class: "text-lg inline-flex items-center") do %>
        Read more
        <%= render Gustwave::Icon.new(:arrow_right, class: "w-3.5 h-3.5 ms-2 rtl:rotate-180") %>
      <% end %>
    <% end %>
  </div>
<% end %>
