<%= render Gustwave::Jumbotron.new(centered: true, container_options: { class: "py-24 lg:py-56" }) do |jumbotron| %>
  <% jumbotron.with_background_image("https://flowbite.s3.amazonaws.com/docs/jumbotron/conference.jpg", fetchpriority: "high") %>

  <%= render Gustwave::Heading.new("We invest in the world’s potential", tag: :h1, size: :"2xl", responsive: true, class: "mb-4 tracking-tight leading-none text-white") %>
  <%= render Gustwave::Paragraph.new("Here at Flowbite we focus on markets where technology, innovation, and capital can unlock long-term value and drive economic growth.", class: "mb-8 text-lg font-normal text-gray-300 dark:text-gray-300 lg:text-xl sm:px-16 lg:px-48") %>

  <div class="flex flex-col space-y-4 sm:flex-row sm:justify-center sm:space-y-0">
    <%= render Gustwave::Buttons::Default.new("Get started", tag: :a, href: "#", size: :lg, class: "justify-center") do |button| %>
      <% button.with_trailing_visual_icon :arrow_right %>
    <% end %>

    <%= render Gustwave::Buttons::Default.new("Learn more", tag: :a, href: "#", color: :alternative, size: :lg, class: "sm:ms-4 bg-transparent text-white border-white hover:text-gray-900 hover:bg-gray-100 focus:ring-gray-400 dark:bg-transparent dark:text-white dark:border-white dark:hover:text-gray-900 dark:hover:bg-gray-100 dark:focus:ring-gray-400") %>
  </div>
<% end %>
