<%= render Gustwave::Breadcrumb.new(solid: true, class: "justify-between px-4 sm:flex sm:px-5", list_options: { class: "mb-3 sm:mb-0" }) do |breadcrumb| %>
  <% breadcrumb.with_item("flowbite.com", href: "#", class: "ms-1 md:ms-2") %>
  <% breadcrumb.with_item("develop", href: "#") %>

  <% breadcrumb.with_item do %>
    Issue #312
    <%= render Gustwave::Badge.new("docs", class: "hidden ms-1 md:ms-2 me-2 px-2 font-semibold dark:bg-blue-200 dark:text-blue-800 sm:flex") %>
  <% end %>

  <%= render Gustwave::Dropdown.new("Fix #6597", icon: :code_branch, size: :sm, color: :base, class: "font-normal text-gray-600 bg-gray-200 hover:bg-gray-300 focus:ring-gray-100 dark:bg-gray-700 dark:hover:bg-gray-600 dark:text-gray-300 dark:focus:ring-gray-700") do |dropdown| %>
    <% dropdown.with_menu_list do |menu| %>
      <% menu.with_item_link "New branch", href: "#" %>
      <% menu.with_item_link "Rename", href: "#" %>
      <% menu.with_item_link "Delete", href: "#" %>
    <% end %>
  <% end %>
<% end %>
