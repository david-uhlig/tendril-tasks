<%= render Gustwave::Breadcrumb.new(solid: true, class: "justify-between px-4 sm:flex sm:px-5", list_options: { class: "mb-3 sm:mb-0" }) do |breadcrumb| %>
  <% breadcrumb.with_item("flowbite.com", href: "#") %>
  <% breadcrumb.with_item("develop", href: "#") %>
  <% breadcrumb.with_item do %>
    Issue #312
    <%= render Gustwave::Badge.new("docs", class: "hidden ms-2 sm:flex") %>
  <% end %>
  <%= render Gustwave::Dropdown.new("Fix #6597", icon: :code_branch) do |dropdown| %>
    <% dropdown.with_menu_list do |menu| %>
      <% menu.with_item_link "New branch", href: "#" %>
      <% menu.with_item_link "Rename", href: "#" %>
      <% menu.with_item_link "Delete", href: "#" %>
    <% end %>
  <% end %>
<% end %>
