<% trigger_class = "font-normal text-gray-900 bg-white hover:bg-gray-100 focus:ring-gray-100 dark:bg-gray-900 dark:hover:bg-gray-800 dark:text-white dark:focus:ring-gray-700" %>

<%= render Gustwave::Breadcrumb.new(separator: :slash, class: "justify-between", list_options: { class: "mb-3 sm:mb-0" }) do |breadcrumb| %>
  <% breadcrumb.with_item do %>
    <%= render Gustwave::Dropdown.new("flowbite.com", icon: :code_branch, size: :sm, color: :base, class: trigger_class) do |dropdown| %>
      <% dropdown.with_menu_list do |menu| %>
        <% menu.with_item_link "themesberg.com", href: "#" %>
        <% menu.with_item_link "ui.glass", href: "#" %>
        <% menu.with_item_link "iconscale", href: "#" %>
      <% end %>
    <% end %>
  <% end %>

  <% breadcrumb.with_item do %>
    <%= render Gustwave::Dropdown.new do |dropdown| %>
      <% dropdown.with_trigger_component(size: :sm, color: :base, class: trigger_class) do %>
        <%= render Gustwave::Icon.new(:database, theme: :solid, class: "h-4 w-auto -mx-0.5", aria: { hidden: true }) %>
        databaseName
      <% end %>

      <% dropdown.with_menu_list do |menu| %>
        <% menu.with_item_link "databaseProd", href: "#" %>
        <% menu.with_item_link "databaseStaging", href: "#" %>
        <% menu.with_item_link "flowbiteProd", href: "#" %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
