<% popover = Gustwave::Popover.new(class: "w-72") %>

<div class="pb-96">
  <%= render Gustwave::Paragraph.new(class: "flex items-center text-sm") do %>
    Task activity
    <%= tag.button(**popover.trigger_options(placement: :"bottom-end"), type: "button") do %>
      <%= render Gustwave::Icon.new(:question_circle, theme: :solid, class: "w-4 h-4 ms-2 text-gray-400 hover:text-gray-500") %>
      <span class="sr-only">Show information</span>
    <% end %>
  <% end %>

  <%= render popover do %>
    <div class="p-3 space-y-2">
      <%= render Gustwave::Heading.new("Activity growth", tag: :h3, size: :none, class: "font-semibold text-gray-900 dark:text-white") %>

      <p>Shows how many people have applied to tasks over time. A rising line means the community is growing.</p>
      <%= render Gustwave::Heading.new("Calculation", tag: :h3, size: :none, class: "font-semibold text-gray-900 dark:text-white") %>

      <p>Each point counts every application made up to that date, including the ones made earlier.</p>

      <%= render Gustwave::Link.new(href: "#", class: "flex items-center hover:text-blue-700 dark:hover:text-blue-600") do %>
        Read more <%= render Gustwave::Icon.new(:chevron_right_compact, class: "w-2 h-2 ms-1.5 rtl:rotate-180") %>
      <% end %>
    </div>
  <% end %>
</div>
