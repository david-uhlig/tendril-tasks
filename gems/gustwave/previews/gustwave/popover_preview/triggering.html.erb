<div class="flex justify-center pt-24">
  <% popover = Gustwave::Popover.new(class: "w-64") %>
  <%= render Gustwave::Buttons::Default.new("Hover popover", class: "me-3", **popover.trigger_options(trigger_event: :hover)) %>

  <%= render popover do %>
    <div class="px-3 py-2 bg-gray-100 border-b border-gray-200 rounded-t-lg dark:border-gray-600 dark:bg-gray-700">
      <%= render Gustwave::Heading.new("Opens on hover", tag: :h3, size: :none, class: "font-semibold text-gray-900 dark:text-white") %>
    </div>

    <div class="px-3 py-2">
      <%= render Gustwave::Paragraph.new("It closes when the pointer leaves.", color: :none) %>
    </div>
  <% end %>

  <% click_popover = Gustwave::Popover.new(class: "w-64") %>
  <%= render Gustwave::Buttons::Default.new("Click popover", **click_popover.trigger_options(trigger_event: :click)) %>

  <%= render click_popover do %>
    <div class="px-3 py-2 bg-gray-100 border-b border-gray-200 rounded-t-lg dark:border-gray-600 dark:bg-gray-700">
      <%= render Gustwave::Heading.new("Opens on click", tag: :h3, size: :none, class: "font-semibold text-gray-900 dark:text-white") %>
    </div>

    <div class="px-3 py-2">
      <%= render Gustwave::Paragraph.new("It closes when focus moves away.", color: :none) %>
    </div>
  <% end %>
</div>
