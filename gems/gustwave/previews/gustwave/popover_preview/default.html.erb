<% popover = Gustwave::Popover.new(class: "w-64") %>

<div class="flex justify-center pt-24">
  <%= render Gustwave::Buttons::Default.new("Show popover", **popover.trigger_options(placement: placement.to_sym, trigger_event: trigger_event.to_sym)) %>

  <%= render popover do %>
    <div class="px-3 py-2 bg-gray-100 border-b border-gray-200 rounded-t-lg dark:border-gray-600 dark:bg-gray-700">
      <%= render Gustwave::Heading.new("Task details", tag: :h3, size: :none, class: "font-semibold text-gray-900 dark:text-white") %>
    </div>

    <div class="px-3 py-2">
      <%= render Gustwave::Paragraph.new("Popovers show extra content next to their trigger.", color: :none) %>
    </div>
  <% end %>
</div>
