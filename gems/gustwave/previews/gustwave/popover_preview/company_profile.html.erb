<% popover = Gustwave::Popover.new(class: "w-80") %>

<div class="flex justify-center pt-80">
  <%= render Gustwave::Buttons::Default.new("Company profile", **popover.trigger_options) %>

  <%= render popover do %>
    <div class="p-3">
      <div class="flex">
        <div class="me-3 shrink-0">
          <%= render Gustwave::Link.new(href: "#", color: :none, class: "block p-2 bg-gray-100 rounded-lg dark:bg-gray-700") do %>
            <%= image_tag "/icon.png", alt: "Northwind Labs logo", class: "w-8 h-8 rounded-full" %>
          <% end %>
        </div>

        <div>
          <p class="mb-1 text-base font-semibold leading-none text-gray-900 dark:text-white">
            <%= render Gustwave::Link.new(href: "#", color: :none, class: "hover:underline") do %>
              Northwind Labs
            <% end %>
          </p>

          <p class="mb-3 text-sm font-normal">
            Software company
          </p>

          <p class="mb-4 text-sm">Open-source tools for community projects and volunteers.</p>

          <ul class="text-sm">
            <li class="flex items-center mb-2">
              <span class="me-2 font-semibold text-gray-400">
                <%= render Gustwave::Icon.new(:globe, class: "w-3.5 h-3.5") %>
              </span>

              <%= render Gustwave::Link.new("https://northwind.example/", href: "#", class: "font-normal") %>
            </li>

            <li class="flex items-start mb-2">
              <span class="me-2 font-semibold text-gray-400">
                <%= render Gustwave::Icon.new(:heart, theme: :solid, class: "w-[18px] h-[18px] -m-0.5") %>
              </span>

              <span class="-mt-1">4,567 people like this including 5 of your friends</span>
            </li>
          </ul>

          <%= render Gustwave::AvatarGroup.new(class: "mb-3 -space-x-3") do %>
            <%= render Gustwave::Avatar.new(src: "/icon.png", size: :sm, class: "border-2 border-white dark:border-gray-800") %>
            <%= render Gustwave::Avatar.new(src: "/icon.png", size: :sm, class: "border-2 border-white dark:border-gray-800") %>
            <%= render Gustwave::Avatar.new(src: "/icon.png", size: :sm, class: "border-2 border-white dark:border-gray-800") %>

            <%= render Gustwave::Link.new("+3", href: "#", color: :none, class: "flex items-center justify-center w-8 h-8 text-xs font-medium text-white bg-gray-400 border-2 border-white rounded-full hover:bg-gray-500 dark:border-gray-800") %>
          <% end %>

          <div class="flex">
            <%= render Gustwave::Buttons::Default.new("Like page", color: :alternative, class: "w-full justify-center px-5 py-2 me-2") do |button| %>
              <% button.with_leading_visual_icon(:thumbs_up, theme: :solid, class: "me-0") %>
            <% end %>

            <%= render Gustwave::Dropdown.new(placement: :right) do |dropdown| %>
              <% dropdown.with_trigger_generic do %>
                <button
                  type="button"
                  aria-label="More options"
                  class="
                    inline-flex items-center px-3 py-2 text-sm font-medium text-gray-900 bg-white border border-gray-200 rounded-lg shrink-0
                    focus:outline-none hover:bg-gray-100 hover:text-blue-700 focus:z-10 focus:ring-4 focus:ring-gray-200
                    dark:focus:ring-gray-700 dark:bg-gray-800 dark:text-gray-400 dark:border-gray-600 dark:hover:text-white dark:hover:bg-gray-700
                  "
                >
                  <svg
                    class="w-3.5 h-3.5"
                    aria-hidden="true"
                    xmlns="http://www.w3.org/2000/svg"
                    fill="currentColor"
                    viewBox="0 0 16 3"
                  >
                    <circle cx="2" cy="1.5" r="1.5" />
                    <circle cx="8" cy="1.5" r="1.5" />
                    <circle cx="14" cy="1.5" r="1.5" />
                  </svg>
                </button>
              <% end %>

              <% dropdown.with_menu_list do |menu| %>
                <% menu.with_item_link "Report this page", href: "#" %>
                <% menu.with_item_link "Add to favourites", href: "#" %>
                <% menu.with_item_link "Block this page", href: "#" %>
                <% menu.with_item_link "Invite people", href: "#" %>
              <% end %>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  <% end %>
</div>
