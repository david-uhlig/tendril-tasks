<div class="flex justify-center pt-32">
  <% popover = Gustwave::Popover.new(arrow: false, class: "w-64") %>
  <%= render Gustwave::Buttons::Default.new("Popover without arrow", **popover.trigger_options) %>

  <%= render popover do %>
    <div class="px-3 py-2 bg-gray-100 border-b border-gray-200 rounded-t-lg dark:border-gray-600 dark:bg-gray-700">
      <%= render Gustwave::Heading.new("No arrow", tag: :h3, size: :none, class: "font-semibold text-gray-900 dark:text-white") %>
    </div>

    <div class="px-3 py-2">
      <%= render Gustwave::Paragraph.new("This popover has no arrow pointing at its trigger.", color: :none) %>
    </div>
  <% end %>
</div>
