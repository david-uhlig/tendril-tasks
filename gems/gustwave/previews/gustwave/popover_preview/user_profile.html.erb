<% popover = Gustwave::Popover.new(class: "w-64") %>

<div class="flex justify-center pt-52">
  <%= render Gustwave::Buttons::Default.new("User profile", **popover.trigger_options) %>

  <%= render popover do %>
    <div class="p-3">
      <div class="flex items-center justify-between mb-2">
        <%= render Gustwave::Link.new(href: "#", color: :none) do %>
          <%= render Gustwave::Avatar.new(src: "/icon.png", alt: "Jane Doe") %>
        <% end %>

        <div>
          <%= render Gustwave::Buttons::Default.new("Follow", size: :xs) %>
        </div>
      </div>

      <p class="text-base font-semibold leading-none text-gray-900 dark:text-white">
        <%= render Gustwave::Link.new("Jane Doe", href: "#", color: :none) %>
      </p>

      <p class="mb-3 text-sm font-normal">
        <%= render Gustwave::Link.new(href: "#", color: :none, class: "hover:underline") do %>
          @janedoe
        <% end %>
      </p>

      <p class="mb-4 text-sm">
        Community organiser. Building
        <%= render Gustwave::Link.new("tendril.example", href: "#", class: "font-normal") %>.
      </p>

      <ul class="flex text-sm">
        <li class="me-2">
          <%= render Gustwave::Link.new(href: "#", color: :none, class: "hover:underline") do %>
            <span class="font-semibold text-gray-900 dark:text-white">42</span>
            <span>Following</span>
          <% end %>
        </li>

        <li>
          <%= render Gustwave::Link.new(href: "#", color: :none, class: "hover:underline") do %>
            <span class="font-semibold text-gray-900 dark:text-white">128</span>
            <span>Followers</span>
          <% end %>
        </li>
      </ul>
    </div>
  <% end %>
</div>
