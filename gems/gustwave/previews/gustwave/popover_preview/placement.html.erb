<div class="flex flex-wrap justify-center py-24 space-x-4">
  <% %i[top right bottom left].each do |placement| %>
    <% popover = Gustwave::Popover.new(class: "w-64") %>
    <%= render Gustwave::Buttons::Default.new("#{placement.to_s.capitalize} popover", class: "mb-3 me-4", **popover.trigger_options(placement:)) %>

    <%= render popover do %>
      <div class="px-3 py-2 bg-gray-100 border-b border-gray-200 rounded-t-lg dark:border-gray-600 dark:bg-gray-700">
        <%= render Gustwave::Heading.new("Shown on the #{placement}", tag: :h3, size: :none, class: "font-semibold text-gray-900 dark:text-white") %>
      </div>

      <div class="px-3 py-2">
        <%= render Gustwave::Paragraph.new("Popovers show extra content next to their trigger.", color: :none) %>
      </div>
    <% end %>
  <% end %>
</div>
