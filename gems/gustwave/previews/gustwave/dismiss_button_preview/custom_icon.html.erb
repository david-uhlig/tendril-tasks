<div
  id="custom-icon-note"
  class="
    flex max-w-sm items-center justify-between gap-4 rounded-lg border border-gray-200 bg-white p-4 text-sm
    text-gray-700 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-300
  "
>
  <p>The dismiss button shows a custom icon set through its slot.</p>

  <%= render Gustwave::DismissButton.new("custom-icon-note", "Dismiss note", color: :dark) do |button| %>
    <% button.with_leading_visual_icon :edit, theme: :solid %>
  <% end %>
</div>
