<%
  clipboards = {
    "account-id" => "756593826",
    "api-key" => "f4h6sd3t-jsy63ind-hsgdt7rs-jdhf76st",
    "role-arn" => "123456789012:user/Flowbite"
  }.map do |target_id, value|
    clipboard = Gustwave::Clipboard.new(
      target_id:,
      theme: :inline,
      color: :none,
      class: "absolute end-2 top-1/2 -translate-y-1/2 text-gray-500 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-800 rounded-lg p-2 inline-flex items-center justify-center"
    )
    clipboard.with_icon(:clipboard, class: "w-4.5 h-4.5")
    clipboard.with_copied_icon(:check, class: "w-4.5 h-4.5 text-blue-700 dark:text-blue-500")
    clipboard.with_tooltip
    [ target_id, value, clipboard ]
  end
%>

<div class="flex justify-center">
  <%= render Gustwave::Card.new(class: "max-w-lg p-5", body_options: { class: "p-0" }) do %>
    <%= render Gustwave::Heading.new("Create a role with read only in-line policies", tag: :h2, size: :none, class: "text-lg font-semibold text-gray-900 dark:text-white mb-2") %>
    <%= render Gustwave::Paragraph.new(class: "mb-6") do %>
      To give Flowbite read access, please create an IAM Role following <%= render Gustwave::Link.new("trust relationship", href: "#", color: :none, underline: :always, class: "text-blue-700 dark:text-blue-500") %> and <%= render Gustwave::Link.new("inline policy", href: "#", color: :none, underline: :always, class: "text-blue-700 dark:text-blue-500") %>.
    <% end %>

    <% clipboards.each do |target_id, value, clipboard| %>
      <label for="<%= target_id %>" class="text-sm font-medium text-gray-900 dark:text-white mb-2 block"><%= { "account-id" => "Flowbite account ID:", "api-key" => "API key:", "role-arn" => "Role ARN:" }.fetch(target_id) %></label>
      <div class="relative <%= target_id == "role-arn" ? "mb-6" : "mb-4" %>">
        <input id="<%= target_id %>" type="text" class="col-span-6 bg-gray-50 border border-gray-300 text-gray-500 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-gray-400 dark:focus:ring-blue-500 dark:focus:border-blue-500" value="<%= value %>" disabled readonly>
        <%= render clipboard %>
      </div>
    <% end %>

    <div class="flex items-center space-x-4 rtl:space-x-reverse">
      <%= render Gustwave::Buttons::Default.new("Cancel", color: :alternative) %>
      <%= render Gustwave::Buttons::Default.new("Next step") %>
    </div>
  <% end %>
</div>
