<div class="flex justify-center">
  <div class="grid grid-cols-8 gap-2 w-full max-w-[23rem]">
    <label for="npm-install" class="sr-only">Label</label>

    <input
      id="npm-install"
      type="text"
      class="
        col-span-6 bg-gray-50 border border-gray-300 text-gray-500 text-sm rounded-lg focus:ring-blue-500
        focus:border-blue-500 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400
        dark:text-gray-400 dark:focus:ring-blue-500 dark:focus:border-blue-500
      "
      value="npm install flowbite"
      disabled
      readonly
    >

    <%= render Gustwave::Clipboard.new("Copy", target_id: "npm-install", class: "col-span-2 w-full sm:w-auto px-0") %>
  </div>
</div>
