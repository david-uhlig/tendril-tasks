<%
  clipboard = Gustwave::Clipboard.new(
    target_id: "contact-details",
    content_type: :text_content,
    theme: :inline,
    color: :none,
    class: "absolute end-2 top-2 text-gray-500 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-800 rounded-lg p-2 inline-flex items-center justify-center"
  )
  clipboard.with_icon(:clipboard, class: "w-4.5 h-4.5")
  clipboard.with_copied_icon(:check, class: "w-4.5 h-4.5 text-blue-700 dark:text-blue-500")
  clipboard.with_tooltip
%>

<div class="flex justify-center">
  <div class="w-full max-w-md">
    <%= render Gustwave::Card.new(class: "max-w-md p-5", body_options: { class: "p-0" }) do %>
      <%= render Gustwave::Heading.new("Contact details", id: "contact-details-title", tag: :h2, size: :none, class: "text-lg font-semibold text-gray-900 dark:text-white mb-2") %>

      <address
        class="
          relative bg-gray-50 dark:bg-gray-700 dark:border-gray-600 p-4 rounded-lg border border-gray-200 not-italic
          grid grid-cols-2
        "
      >
        <div class="space-y-2 text-gray-500 dark:text-gray-400 leading-loose hidden sm:block">
          Name
          <br>
          Email
          <br>
          Phone Number
        </div>

        <div id="contact-details" class="space-y-2 text-gray-900 dark:text-white font-medium leading-loose">
          Bonnie Green
          <br>
          name@flowbite.com
          <br>
          + 12 345 67890
        </div>

        <%= render clipboard %>
      </address>
    <% end %>
  </div>
</div>
