<div
  class="
    relative mx-auto my-12 w-56 h-56 bg-gray-100 border border-gray-200 rounded-lg dark:bg-gray-800
    dark:border-gray-700
  "
>
  <% [ [ "top-center", :top_center ], [ "top-left", :top_left ], [ "top-right", :top_right ],
     [ "middle-center", :middle_center ], [ "middle-left", :middle_left ], [ "middle-right", :middle_right ],
     [ "bottom-center", :bottom_center ], [ "bottom-left", :bottom_left ], [ "bottom-right", :bottom_right ] ].each do |label, position| %>
    <%= render Gustwave::Indicator.new(label, size: :none, position:, class: "px-2 py-0.5 bg-blue-200 text-center text-xs font-medium leading-none text-blue-800 dark:bg-blue-900 dark:text-blue-200") %>
  <% end %>
</div>
