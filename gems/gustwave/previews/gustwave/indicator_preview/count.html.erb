<div class="flex items-center justify-center">
  <%= render Gustwave::Buttons::Default.new(class: "relative overflow-visible") do |button| %>
    <% button.with_leading_visual_icon :envelope, theme: :solid, class: "h-[19.2px] w-[19.2px] -m-[1.6px]" %>
    <span class="sr-only">Notifications</span> Messages
    <%= render Gustwave::Indicator.new("8", color: :red, size: :xl, class: "absolute -top-2 -end-2 border-2 border-white text-xs font-bold dark:border-gray-900") %>
  <% end %>
</div>
