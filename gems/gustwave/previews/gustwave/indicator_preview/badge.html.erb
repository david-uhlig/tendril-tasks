<ul role="list" class="mx-auto w-fit max-w-sm divide-y divide-gray-200 dark:divide-gray-700">
  <% [ [ "Neil Sims", "neil@example.com", :green, "Available" ], [ "Bonnie Green", "bonnie@example.com", :red, "Unavailable" ] ].each do |name, email, color, status| %>
    <li class="py-3 sm:py-4">
      <div class="flex items-center space-x-3 rtl:space-x-reverse">
        <div class="shrink-0">
          <%= render Gustwave::Avatar.new(src: "/icon.png", alt: name, size: :sm) %>
        </div>

        <div class="flex-1 min-w-0">
          <p class="text-sm font-semibold text-gray-900 truncate dark:text-white"><%= name %></p>
          <p class="text-sm text-gray-500 truncate dark:text-gray-400"><%= email %></p>
        </div>

        <%= render Gustwave::Badge.new(color:, pill: true) do %>
          <%= render Gustwave::Indicator.new(color:, size: :none, class: "h-2 w-2 me-1") %> <%= status %>
        <% end %>
      </div>
    </li>
  <% end %>
</ul>
