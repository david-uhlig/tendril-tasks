<div class="flex flex-col gap-4">
  <div class="flex flex-wrap items-center gap-4">
    <% sizes.each do |size| %>
      <%= render Gustwave::Indicator.new(color: :blue, size:) %>
    <% end %>
  </div>

  <div class="flex flex-wrap items-center gap-4">
    <% sizes.intersection(%i[lg xl 2xl]).each do |size| %>
      <%= render Gustwave::Indicator.new("3", color: :blue, size:) %>
    <% end %>
  </div>
</div>
