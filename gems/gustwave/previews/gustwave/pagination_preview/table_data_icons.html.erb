<div class="flex flex-col gap-4">
  <%# Flowbite's arrow size: Gustwave's arrows fill a small part of their 24x24 viewBox %>
  <% arrow = "h-5.5 w-5.5 -mx-1 *:stroke-2 rtl:rotate-180" %>

  <%# table_data_icons, the small size %>
  <% dark = "text-white bg-gray-800 hover:bg-gray-900 dark:hover:bg-gray-700 dark:text-gray-400 dark:hover:text-white" %>

  <div class="flex flex-col items-center">
    <%= render Gustwave::Paragraph.new(class: "text-sm text-gray-700 dark:text-gray-400") do %>
      Showing <span class="font-semibold text-gray-900 dark:text-white">1</span> to
      <span class="font-semibold text-gray-900 dark:text-white">10</span> of
      <span class="font-semibold text-gray-900 dark:text-white">100</span> Entries
    <% end %>

    <%= render Gustwave::ButtonGroup.new(class: "mt-2 xs:mt-0") do |group| %>
      <% group.with_button("Prev", color: :base, size: :xs, class: "text-sm #{dark} gap-2 border-0 rounded-s") do |button| %>
        <% button.with_leading_visual_icon(:arrow_left, class: arrow) %>
      <% end %>

      <% group.with_button("Next", color: :base, size: :xs, class: "text-sm #{dark} gap-2 border-0 border-s border-gray-700 rounded-e") do |button| %>
        <% button.with_trailing_visual_icon(:arrow_right, class: arrow) %>
      <% end %>
    <% end %>
  </div>

  <%# table_data_icons, the large size %>
  <% large = "h-10 px-4 text-base" %>

  <div class="flex flex-col items-center">
    <%= render Gustwave::Paragraph.new(class: "text-sm text-gray-700 dark:text-gray-400") do %>
      Showing <span class="font-semibold text-gray-900 dark:text-white">1</span> to
      <span class="font-semibold text-gray-900 dark:text-white">10</span> of
      <span class="font-semibold text-gray-900 dark:text-white">100</span> Entries
    <% end %>

    <%= render Gustwave::ButtonGroup.new(class: "mt-2 xs:mt-0") do |group| %>
      <% group.with_button("Prev", color: :base, size: :xs, class: "#{large} #{dark} gap-2 border-0 rounded-s") do |button| %>
        <% button.with_leading_visual_icon(:arrow_left, class: arrow) %>
      <% end %>

      <% group.with_button("Next", color: :base, size: :xs, class: "#{large} #{dark} gap-2 border-0 border-s border-gray-700 rounded-e") do |button| %>
        <% button.with_trailing_visual_icon(:arrow_right, class: arrow) %>
      <% end %>
    <% end %>
  </div>
</div>
