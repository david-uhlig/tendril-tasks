<div class="flex flex-col gap-4">
  <%# Flowbite's arrow size: Gustwave's arrows fill a small part of their 24x24 viewBox %>
  <% arrow = "h-5.5 w-5.5 -mx-1 *:stroke-2 rtl:rotate-180" %>

  <%# previous_next_icons, the small size %>
  <div class="flex gap-3">
    <%= render Gustwave::Button.for(:default).new("Previous", tag: :a, href: "#", color: :alternative, size: :xs, class: "flex items-center gap-2 text-sm text-gray-500 border-gray-300 hover:text-gray-700") do |button| %>
      <% button.with_leading_visual_icon(:arrow_left, class: arrow) %>
    <% end %>

    <%= render Gustwave::Button.for(:default).new("Next", tag: :a, href: "#", color: :alternative, size: :xs, class: "flex items-center gap-2 text-sm text-gray-500 border-gray-300 hover:text-gray-700") do |button| %>
      <% button.with_trailing_visual_icon(:arrow_right, class: arrow) %>
    <% end %>
  </div>

  <%# previous_next_icons, the large size %>
  <div class="flex gap-3">
    <%= render Gustwave::Button.for(:default).new("Previous", tag: :a, href: "#", color: :alternative, size: :xs, class: "flex items-center gap-2 h-10 px-4 text-base text-gray-500 border-gray-300 hover:text-gray-700") do |button| %>
      <% button.with_leading_visual_icon(:arrow_left, class: arrow) %>
    <% end %>

    <%= render Gustwave::Button.for(:default).new("Next", tag: :a, href: "#", color: :alternative, size: :xs, class: "flex items-center gap-2 h-10 px-4 text-base text-gray-500 border-gray-300 hover:text-gray-700") do |button| %>
      <% button.with_trailing_visual_icon(:arrow_right, class: arrow) %>
    <% end %>
  </div>
</div>
