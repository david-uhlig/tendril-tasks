<div class="flex flex-col gap-4">
  <%# previous_next, the small size %>
  <div class="flex gap-3">
    <%= render Gustwave::Button.for(:default).new("Previous", tag: :a, href: "#", color: :alternative, size: :xs, class: "flex items-center text-sm text-gray-500 border-gray-300 hover:text-gray-700") %>
    <%= render Gustwave::Button.for(:default).new("Next", tag: :a, href: "#", color: :alternative, size: :xs, class: "flex items-center text-sm text-gray-500 border-gray-300 hover:text-gray-700") %>
  </div>

  <%# previous_next, the large size %>
  <div class="flex gap-3">
    <%= render Gustwave::Button.for(:default).new("Previous", tag: :a, href: "#", color: :alternative, size: :xs, class: "flex items-center h-10 px-4 text-base text-gray-500 border-gray-300 hover:text-gray-700") %>
    <%= render Gustwave::Button.for(:default).new("Next", tag: :a, href: "#", color: :alternative, size: :xs, class: "flex items-center h-10 px-4 text-base text-gray-500 border-gray-300 hover:text-gray-700") %>
  </div>
</div>
