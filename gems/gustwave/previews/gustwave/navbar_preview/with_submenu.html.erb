  <% end %>

  <% navbar.with_actions do %>
    <div class="flex items-center space-x-6 rtl:space-x-reverse">
      <%= render Gustwave::Link.new("(555) 412-1234", href: "tel:5541251234", color: :none, underline: :none, class: "text-sm text-gray-500 dark:text-white hover:underline") %>
      <%= render Gustwave::Link.new("Login", href: "#", color: :none, underline: :none, class: "text-sm text-blue-600 dark:text-blue-500 hover:underline") %>
    </div>
  <% end %>
<% end %>

<nav class="bg-gray-50 dark:bg-gray-700">
