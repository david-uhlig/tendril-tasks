      <ul class="flex flex-row font-medium mt-0 space-x-8 rtl:space-x-reverse text-sm">
        <li>
          <%= render Gustwave::Link.new("Home", href: "#", aria: { current: "page" }, color: :none, underline: :none, class: "text-gray-900 dark:text-white hover:underline") %>
        </li>

        <li>
          <%= render Gustwave::Link.new("Company", href: "#", color: :none, underline: :none, class: "text-gray-900 dark:text-white hover:underline") %>
        </li>

        <li>
          <%= render Gustwave::Link.new("Team", href: "#", color: :none, underline: :none, class: "text-gray-900 dark:text-white hover:underline") %>
        </li>

        <li>
          <%= render Gustwave::Link.new("Features", href: "#", color: :none, underline: :none, class: "text-gray-900 dark:text-white hover:underline") %>
        </li>
      </ul>
    </div>
  </div>
