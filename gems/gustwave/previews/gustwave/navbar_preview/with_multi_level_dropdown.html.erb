<%= render Gustwave::Navbar.new do |navbar| %>
  <% navbar.with_brand(href: "#") do %>
    <%= render Gustwave::Icon.new(:rocket, theme: :solid, position: :standalone, class: "size-8 text-blue-700 dark:text-blue-500") %>
    <span class="self-center text-2xl font-semibold whitespace-nowrap dark:text-white">Flowbite</span>
  <% end %>

  <% navbar.with_item_link "Home", href: "#", active: true %>

  <% navbar.with_item_generic do %>
    <%= render Gustwave::Dropdown.new("Account", inline: true, class: "flex justify-between w-full md:w-auto py-2 px-3 md:p-0 text-gray-900 hover:bg-gray-100 md:hover:bg-transparent md:hover:text-blue-700 dark:text-white dark:hover:bg-gray-700 dark:hover:text-white md:dark:hover:bg-transparent md:dark:hover:text-blue-500") do |dropdown| %>
      <% dropdown.with_menu_list class: "font-normal dark:divide-gray-600" do |menu| %>
        <% menu.with_item_link "Dashboard", href: "#" %>

        <% menu.with_item_dropdown "Reports", placement: :right_start, trigger_event: :click do |submenu| %>
          <% submenu.with_menu_list do |submenu_list| %>
            <% submenu_list.with_item_link "Overview", href: "#" %>
            <% submenu_list.with_item_link "My downloads", href: "#" %>
            <% submenu_list.with_item_link "Billing", href: "#" %>
            <% submenu_list.with_item_link "Rewards", href: "#" %>
          <% end %>
        <% end %>

        <% menu.with_item_link "Earnings", href: "#" %>

        <% menu.with_footer class: "px-0 py-1" do %>
          <a
            href="#example"
            class="
              block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 dark:hover:bg-gray-600 dark:text-gray-200
              dark:hover:text-white
            "
          >
            Sign out
          </a>
        <% end %>
      <% end %>
    <% end %>
  <% end %>

  <% navbar.with_item_link "Services", href: "#" %>
  <% navbar.with_item_link "Pricing", href: "#" %>
  <% navbar.with_item_link "Contact", href: "#" %>
<% end %>
