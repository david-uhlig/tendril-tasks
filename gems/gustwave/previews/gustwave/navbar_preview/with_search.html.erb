<%= render Gustwave::Navbar.new(menu_id: "navbar-search") do |navbar| %>
  <% navbar.with_brand(href: "#") do %>
    <%= render Gustwave::Icon.new(:rocket, theme: :outline, position: :standalone, class: "size-8 text-blue-700 dark:text-blue-500") %>
    <span class="self-center text-2xl font-semibold whitespace-nowrap dark:text-white">Acme</span>
  <% end %>

  <% navbar.with_actions do %>
    <%= render Gustwave::Buttons::Inline.new(color: :dark, size: :md, aria: { label: "Search", controls: "navbar-search", expanded: false }, data: { collapse_toggle: "navbar-search" }, class: "md:hidden me-1 p-2.5 rounded-lg text-gray-500 hover:bg-gray-100 hover:text-gray-500 focus:ring-4 focus:ring-gray-200 dark:text-gray-400 dark:hover:bg-gray-700 dark:hover:text-gray-400 dark:focus:ring-gray-700") do |button| %>
      <% button.with_leading_visual_icon :search, theme: :outline %>
    <% end %>

    <div class="relative hidden md:block">
      <%= render Gustwave::Form::Input.new(type: :search, size: :sm, placeholder: "Search...", aria: { label: "Search" }, class: "text-sm") do |input| %>
        <% input.with_leading_visual_icon :search, theme: :outline %>
      <% end %>
    </div>
  <% end %>

  <% navbar.with_item_generic(class: "md:hidden") do %>
    <%= render Gustwave::Form::Input.new(type: :search, size: :sm, placeholder: "Search...", aria: { label: "Search" }, class: "text-sm") do |input| %>
      <% input.with_leading_visual_icon :search, theme: :outline %>
    <% end %>
  <% end %>

  <% navbar.with_item_link "Home", href: "#", active: true %>
  <% navbar.with_item_link "About", href: "#" %>
  <% navbar.with_item_link "Services", href: "#" %>
<% end %>
