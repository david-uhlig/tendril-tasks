<%= render Gustwave::Navbar.new do |navbar| %>
  <% navbar.with_brand(href: "#") do %>
    <%= render Gustwave::Icon.new(:rocket, theme: :solid, position: :standalone, class: "size-8 text-blue-700 dark:text-blue-500") %>
    <span class="self-center text-2xl font-semibold whitespace-nowrap dark:text-white">Flowbite</span>
  <% end %>

  <% navbar.with_item_link "Home", href: "#", active: true %>
  <% navbar.with_item_link "About", href: "#" %>
  <% navbar.with_item_link "Services", href: "#" %>
  <% navbar.with_item_link "Pricing", href: "#" %>
  <% navbar.with_item_link "Contact", href: "#" %>

  <% navbar.with_actions do %>
    <%= render Gustwave::Dropdown.new("English (US)", inline: true, icon: :globe, trailing_icon: false, class: "inline-flex items-center font-medium justify-center px-4 py-2 text-sm text-gray-900 dark:text-white rounded-lg cursor-pointer hover:bg-gray-100 dark:hover:bg-gray-700 dark:hover:text-white") do |dropdown| %>
      <% dropdown.with_menu_list class: "min-w-0 font-medium" do |menu| %>
        <% menu.with_item_link "English (US)", href: "#", icon: :globe %>
        <% menu.with_item_link "Deutsch", href: "#", icon: :globe %>
        <% menu.with_item_link "Italiano", href: "#", icon: :globe %>
        <% menu.with_item_link "中文 (繁體)", href: "#", icon: :globe %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
