<%= render Gustwave::Form::Field.new(label: "Task title", validation: :success, class: "mb-6") do |field| %>
  <% field.with_control_input(id: "success", placeholder: "Title") %>

  <% field.with_validation_message do %>
    <span class="font-medium">Well done!</span> That title is free.
  <% end %>
<% end %>

<%= render Gustwave::Form::Field.new(label: "Task title", validation: :error) do |field| %>
  <% field.with_control_input(id: "error", placeholder: "Title") %>

  <% field.with_validation_message do %>
    <span class="font-medium">Oops!</span> That title is already taken.
  <% end %>
<% end %>
