<form action="#">
  <div class="grid gap-6 mb-6 md:grid-cols-2">
    <%= render Gustwave::Form::Field.new(label: "First name") do |field| %>
      <% field.with_control_input(id: "first_name", placeholder: "Ada", required: true) %>
    <% end %>

    <%= render Gustwave::Form::Field.new(label: "Last name") do |field| %>
      <% field.with_control_input(id: "last_name", placeholder: "Lovelace", required: true) %>
    <% end %>

    <%= render Gustwave::Form::Field.new(label: "Company") do |field| %>
      <% field.with_control_input(id: "company", placeholder: "Analytical Engines", required: true) %>
    <% end %>

    <%= render Gustwave::Form::Field.new(label: "Phone number") do |field| %>
      <% field.with_control_input(type: :tel, id: "phone", placeholder: "123-45-678", pattern: "[0-9]{3}-[0-9]{2}-[0-9]{3}", required: true) %>
    <% end %>

    <%= render Gustwave::Form::Field.new(label: "Website URL") do |field| %>
      <% field.with_control_input(type: :url, id: "website", placeholder: "analytical.example", required: true) %>
    <% end %>

    <%= render Gustwave::Form::Field.new(label: "Open tasks (per month)") do |field| %>
      <% field.with_control_input(type: :number, id: "tasks", placeholder: "", required: true) %>
    <% end %>
  </div>

  <%= render Gustwave::Form::Field.new(label: "Email address", class: "mb-6") do |field| %>
    <% field.with_control_input(type: :email, id: "email", placeholder: "ada@analytical.example", required: true) %>
  <% end %>

  <%= render Gustwave::Form::Field.new(label: "Password", class: "mb-6") do |field| %>
    <% field.with_control_input(type: :password, id: "password", placeholder: "•••••••••", required: true) %>
  <% end %>

  <%= render Gustwave::Form::Field.new(label: "Confirm password", class: "mb-6") do |field| %>
    <% field.with_control_input(type: :password, id: "confirm_password", placeholder: "•••••••••", required: true) %>
  <% end %>

  <%= render Gustwave::Form::InlineField.new(class: "mb-6") do |field| %>
    <% field.with_control_checkbox(id: "remember", value: "", required: true) %>
    <% field.with_label(safe_join([ "I agree with the ", render(Gustwave::Link.new("terms and conditions", href: "#terms")), "." ])) %>
  <% end %>

  <%= render Gustwave::Buttons::Default.new("Create account", type: :submit, class: "w-full sm:w-auto") %>
</form>
