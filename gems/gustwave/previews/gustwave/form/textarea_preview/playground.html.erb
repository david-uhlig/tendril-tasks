<%= render Gustwave::Form::Field.new(label: "Playground", helper_text: "Change the options in the params panel.", validation: validation) do |field| %>
  <% field.with_control_textarea(id: "playground-textarea", rows: rows, placeholder: placeholder, disabled: disabled) do |textarea| %>
    <% textarea.with_header { "Header" } if %i[header both].include?(frame) %>
    <% textarea.with_footer { "Footer" } if %i[footer both].include?(frame) %>
  <% end %>
<% end %>
