<form action="#editor">
  <%= render Gustwave::Form::Field.new do |field| %>
    <% field.with_label("Publish post", class: "sr-only") %>

    <% field.with_control_textarea(id: "editor", rows: 8, placeholder: "Write an article...", required: true, frame_options: { class: "mb-4" }) do |textarea| %>
      <% textarea.with_header do %>
        <%#
          Plain Tailwind, copied from Flowbite: Gustwave's buttons don't have these classes.
          Gustwave's icons leave a margin inside their box, so each icon is 20px with a negative margin: it's drawn at
          the size of Flowbite's 16px one and the buttons keep their size.
        %>
        <% full_screen_tooltip = Gustwave::Tooltip.new("Show full screen") %>

        <div class="flex flex-wrap items-center divide-gray-200 sm:divide-x sm:rtl:divide-x-reverse dark:divide-gray-600">
          <div class="flex items-center space-x-1 rtl:space-x-reverse sm:pe-4">
            <% [ [ :paper_clip, "Attach file" ], [ :map_pin, "Embed map" ], [ :image, "Upload image" ], [ :code, "Format code" ], [ :face_grin, "Add emoji" ] ].each do |icon, label| %>
              <button
                type="button"
                class="
                  p-2 text-gray-500 rounded-sm cursor-pointer hover:text-gray-900 hover:bg-gray-100 dark:text-gray-400
                  dark:hover:text-white dark:hover:bg-gray-600
                "
              >
                <%= render Gustwave::Icon.new(icon, class: "w-5 h-5 -m-0.5", aria: { hidden: true }) %>
                <span class="sr-only"><%= label %></span>
              </button>
            <% end %>
          </div>

          <div class="flex flex-wrap items-center space-x-1 rtl:space-x-reverse sm:ps-4">
            <% [ [ :list, "Add list" ], [ :cog, "Settings" ], [ :clock, "Timeline" ], [ :download, "Download" ] ].each do |icon, label| %>
              <button
                type="button"
                class="
                  p-2 text-gray-500 rounded-sm cursor-pointer hover:text-gray-900 hover:bg-gray-100 dark:text-gray-400
                  dark:hover:text-white dark:hover:bg-gray-600
                "
              >
                <%= render Gustwave::Icon.new(icon, class: "w-5 h-5 -m-0.5", aria: { hidden: true }) %>
                <span class="sr-only"><%= label %></span>
              </button>
            <% end %>
          </div>
        </div>

        <%= tag.button(type: "button", class: "p-2 text-gray-500 rounded-sm cursor-pointer sm:ms-auto hover:text-gray-900 hover:bg-gray-100 dark:text-gray-400 dark:hover:text-white dark:hover:bg-gray-600", **full_screen_tooltip.trigger_options) do %>
          <%= render Gustwave::Icon.new(:expand, class: "w-5 h-5 -m-0.5", aria: { hidden: true }) %>
          <span class="sr-only">Full screen</span>
        <% end %>

        <%= render full_screen_tooltip %>
      <% end %>
    <% end %>
  <% end %>

  <button
    type="submit"
    class="
      inline-flex items-center px-5 py-2.5 text-sm font-medium text-center text-white bg-blue-700 rounded-lg
      focus:ring-4 focus:ring-blue-200 dark:focus:ring-blue-900 hover:bg-blue-800
    "
  >
    Publish post
  </button>
</form>
