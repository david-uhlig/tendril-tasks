<%= render Gustwave::Form::Field.new(label: "Your message", validation: :success, class: "mb-6") do |field| %>
  <% field.with_control_textarea(id: "success", rows: 4, placeholder: "Write your thoughts here...") %>

  <% field.with_validation_message do %>
    <span class="font-medium">Well done!</span> Your message was sent.
  <% end %>
<% end %>

<%= render Gustwave::Form::Field.new(label: "Your message", validation: :error) do |field| %>
  <% field.with_control_textarea(id: "error", rows: 4, placeholder: "Write your thoughts here...") %>

  <% field.with_validation_message do %>
    <span class="font-medium">Oops!</span> Your message can't be empty.
  <% end %>
<% end %>
