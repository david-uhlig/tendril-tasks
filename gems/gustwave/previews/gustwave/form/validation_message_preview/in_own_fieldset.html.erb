<%# The builder sends every option but the field's own to the checkbox, so the spacing goes on a wrapper %>
<%= form_with model: settings, scope: :settings, url: "#", builder: Gustwave::FormBuilder do |f| %>
  <fieldset aria-describedby="<%= f.field_id(:channels, :validation_message) %>">
    <legend class="mb-2 text-sm font-medium text-red-700 dark:text-red-500">Notify me by</legend>

    <div class="mb-4">
      <%= f.check_box :channels, { multiple: true, label: "Email" }, "email", nil %>
    </div>
    <div class="mb-4">
      <%= f.check_box :channels, { multiple: true, label: "Text message" }, "sms", nil %>
    </div>
    <%= f.check_box :channels, { multiple: true, label: "Push notification" }, "push", nil %>

    <%= f.validation_message :channels %>
  </fieldset>
<% end %>
