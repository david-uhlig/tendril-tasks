<%= render Gustwave::Form::InlineField.new(label: "Sync is unavailable", class: "mb-5") do |field| %>
  <% field.with_control_toggle(id: "sync", value: "", disabled: true) %>
<% end %>

<%= render Gustwave::Form::InlineField.new(label: "Sync is locked on") do |field| %>
  <% field.with_control_toggle(id: "sync-locked", value: "", checked: true, disabled: true) %>
<% end %>
