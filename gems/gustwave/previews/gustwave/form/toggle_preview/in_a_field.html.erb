<%= render Gustwave::Form::Field.new(label: "Notifications", helper_text: "We send at most one email a week.") do |field| %>
  <% field.with_control_toggle(id: "notifications", name: "notifications", value: "1") %>
<% end %>

<%= render Gustwave::Form::Field.new(label: false, validation: :error, validation_message: "Accept the terms to continue.", class: "mt-6") do |field| %>
  <% field.with_control_toggle(id: "terms", name: "terms", value: "1") { "I accept the terms" } %>
<% end %>
