<%= render Gustwave::Form::InlineField.new(label: "Weekly summary", class: "mb-5") do |field| %>
  <% field.with_control_toggle(id: "weekly-summary", value: "") %>
<% end %>

<%= render Gustwave::Form::InlineField.new(label: "Product updates", class: "mb-5") do |field| %>
  <% field.with_control_toggle(id: "product-updates", value: "", checked: true) %>
<% end %>

<%= render Gustwave::Form::InlineField.new(label: "Security alerts", class: "mb-5") do |field| %>
  <% field.with_control_toggle(id: "security-alerts", value: "", disabled: true) %>
<% end %>
