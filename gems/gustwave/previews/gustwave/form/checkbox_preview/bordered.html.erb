<div class="grid gap-6 md:grid-cols-2">
  <%= render Gustwave::Form::InlineField.new(class: "ps-4 border border-gray-200 rounded-sm dark:border-gray-700", row_options: { class: "items-center" }, text_options: { class: "w-full" }) do |field| %>
    <% field.with_control_checkbox(id: "bordered-comments", name: "notifications", value: "") %>
    <% field.with_label("New comments", class: "block py-4") %>
  <% end %>

  <%= render Gustwave::Form::InlineField.new(class: "ps-4 border border-gray-200 rounded-sm dark:border-gray-700", row_options: { class: "items-center" }, text_options: { class: "w-full" }) do |field| %>
    <% field.with_control_checkbox(id: "bordered-mentions", name: "notifications", value: "", checked: true) %>
    <% field.with_label("Mentions", class: "block py-4") %>
  <% end %>
</div>
