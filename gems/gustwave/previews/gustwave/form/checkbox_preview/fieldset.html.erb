<%# Flowbite's forms page adds a dark focus ring offset to the checkboxes of this example %>
<% offset = "dark:focus:ring-offset-gray-800" %>

<fieldset>
  <legend class="sr-only">Account settings</legend>

  <%= render Gustwave::Form::InlineField.new(class: "mb-4") do |field| %>
    <% field.with_control_checkbox(id: "fieldset-terms", value: "", checked: true, class: offset) %>
    <% field.with_label(safe_join([ "I agree to the ", render(Gustwave::Link.new("terms and conditions", href: "#")), "." ])) %>
  <% end %>

  <%= render Gustwave::Form::InlineField.new(label: "Send me product updates", class: "mb-4") do |field| %>
    <% field.with_control_checkbox(id: "fieldset-updates", value: "", class: offset) %>
  <% end %>

  <%= render Gustwave::Form::InlineField.new(label: "I am 18 years or older", class: "mb-4") do |field| %>
    <% field.with_control_checkbox(id: "fieldset-age", value: "", class: offset) %>
  <% end %>

  <%= render Gustwave::Form::InlineField.new(label: "Remind me before a task is due", class: "mb-4") do |field| %>
    <% field.with_control_checkbox(id: "fieldset-reminder", value: "", class: offset) %>
    <% field.with_helper_text("One email on the morning of the day before the due date.", class: "dark:text-gray-400") %>
  <% end %>

  <%# Flowbite draws the disabled checkbox of this example lighter and with a wider focus ring %>
  <%= render Gustwave::Form::InlineField.new(label: "Sync with the calendar (not available on your plan)") do |field| %>
    <% field.with_control_checkbox(id: "fieldset-sync", value: "", disabled: true, class: "bg-gray-50 focus:ring-3 focus:ring-blue-300 #{offset}") %>
  <% end %>
</fieldset>
