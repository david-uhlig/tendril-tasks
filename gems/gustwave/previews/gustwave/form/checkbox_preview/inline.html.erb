<div class="flex">
  <%= render Gustwave::Form::InlineField.new(label: "Open", class: "me-4") do |field| %>
    <% field.with_control_checkbox(id: "status-open", name: "status[]", value: "open") %>
  <% end %>

  <%= render Gustwave::Form::InlineField.new(label: "In progress", class: "me-4") do |field| %>
    <% field.with_control_checkbox(id: "status-in-progress", name: "status[]", value: "in_progress") %>
  <% end %>

  <%= render Gustwave::Form::InlineField.new(label: "Done", class: "me-4") do |field| %>
    <% field.with_control_checkbox(id: "status-done", name: "status[]", value: "done", checked: true) %>
  <% end %>

  <%= render Gustwave::Form::InlineField.new(label: "Archived") do |field| %>
    <% field.with_control_checkbox(id: "status-archived", name: "status[]", value: "archived", disabled: true) %>
  <% end %>
</div>
