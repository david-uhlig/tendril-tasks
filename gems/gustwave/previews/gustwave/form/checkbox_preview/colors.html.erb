<div class="flex flex-wrap">
  <% %i[red green purple teal yellow orange].each do |color| %>
    <%= render Gustwave::Form::InlineField.new(label: color.to_s.capitalize, class: "me-4") do |field| %>
      <% field.with_control_checkbox(id: "color-#{color}", value: "", checked: true, color: color) %>
    <% end %>
  <% end %>
</div>
