<%= render Gustwave::Form::InlineField.new(label: "I accept the terms", validation: :error, validation_message: "Accept the terms to continue.") do |field| %>
  <% field.with_control_checkbox(id: "accept-terms", name: "terms", value: "1") %>
<% end %>

<%= render Gustwave::Form::InlineField.new(label: "Two-factor authentication", helper_text: "Required for every member of this workspace.", validation: :success, validation_message: "Two-factor authentication is on.", class: "mt-6") do |field| %>
  <% field.with_control_checkbox(id: "two-factor", name: "two_factor", value: "1", checked: true) %>
<% end %>
