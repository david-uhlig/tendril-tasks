<h3 class="mb-5 text-lg font-medium text-gray-900 dark:text-white">Choose your notifications:</h3>

<ul class="grid w-full gap-6 md:grid-cols-3">
  <% [
       [ "option-reminders", :bell, "text-sky-500", "Reminders", "An email before a task is due.", { required: true } ],
       [ "option-digest", :calendar_week, "text-green-400", "Weekly digest", "Every Monday, what changed in your projects.", {} ],
       [ "option-reports", :chart_pie, "text-red-600", "Reports", "A monthly overview of finished tasks.", {} ]
     ].each do |id, icon, icon_color, title, description, attributes| %>
    <li>
      <%= render Gustwave::Form::Checkbox.new(id: id, value: "", class: "hidden peer", **attributes) %>

      <label
        for="<%= id %>"
        class="
          inline-flex items-center justify-between w-full p-5 text-gray-500 bg-white border-2 border-gray-200 rounded-lg
          cursor-pointer dark:hover:text-gray-300 dark:border-gray-700 peer-checked:border-blue-600
          dark:peer-checked:border-blue-600 hover:text-gray-600 dark:peer-checked:text-gray-300
          peer-checked:text-gray-600 hover:bg-gray-50 dark:text-gray-400 dark:bg-gray-800 dark:hover:bg-gray-700
        "
      >
        <div class="block">
          <%= render Gustwave::Icon.new(icon, theme: :solid, class: "mb-2 w-7 h-7 #{icon_color}") %>

          <div class="w-full text-lg font-semibold"><%= title %></div>
          <div class="w-full text-sm"><%= description %></div>
        </div>
      </label>
    </li>
  <% end %>
</ul>
