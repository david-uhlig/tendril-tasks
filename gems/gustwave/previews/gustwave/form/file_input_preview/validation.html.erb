<%= render Gustwave::Form::Field.new(label: "Upload file", validation: :success, class: "mb-6") do |field| %>
  <% field.with_control_file_input(id: "success") %>

  <% field.with_validation_message do %>
    <span class="font-medium">Well done!</span> Your file was uploaded.
  <% end %>
<% end %>

<%= render Gustwave::Form::Field.new(label: "Upload file", validation: :error) do |field| %>
  <% field.with_control_file_input(id: "error") %>

  <% field.with_validation_message do %>
    <span class="font-medium">Oops!</span> Your file is larger than 2 MB.
  <% end %>
<% end %>
