<div class="flex">
  <%= render Gustwave::Form::InlineField.new(label: "Open", class: "me-4") do |field| %>
    <% field.with_control_radio(id: "inline-radio", name: "inline-radio-group", value: "open") %>
  <% end %>

  <%= render Gustwave::Form::InlineField.new(label: "In progress", class: "me-4") do |field| %>
    <% field.with_control_radio(id: "inline-2-radio", name: "inline-radio-group", value: "in_progress") %>
  <% end %>

  <%= render Gustwave::Form::InlineField.new(label: "Done", class: "me-4") do |field| %>
    <% field.with_control_radio(id: "inline-checked-radio", name: "inline-radio-group", value: "done", checked: true) %>
  <% end %>

  <%= render Gustwave::Form::InlineField.new(label: "Archived") do |field| %>
    <% field.with_control_radio(id: "inline-disabled-radio", name: "inline-radio-group", value: "archived", disabled: true) %>
  <% end %>
</div>
