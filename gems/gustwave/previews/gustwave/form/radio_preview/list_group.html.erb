<%# Flowbite's radio inside a list group: darker in dark mode, for the list's gray background %>
<% in_list = "dark:ring-offset-gray-700 dark:focus:ring-offset-gray-700 dark:bg-gray-600 dark:border-gray-500" %>

<h3 class="mb-4 font-semibold text-gray-900 dark:text-white">Priority</h3>

<%= render Gustwave::ListGroup.new(class: "w-48") do |list_group| %>
  <% [ %w[low Low], %w[normal Normal], %w[high High], %w[urgent Urgent] ].each do |value, text| %>
    <% list_group.with_item_text(class: "p-0") do %>
      <%= render Gustwave::Form::InlineField.new(class: "ps-3", row_options: { class: "items-center" }, text_options: { class: "w-full" }) do |field| %>
        <% field.with_control_radio(id: "list-radio-#{value}", name: "priority", value: value, class: in_list) %>
        <% field.with_label(text, class: "block py-3") %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
