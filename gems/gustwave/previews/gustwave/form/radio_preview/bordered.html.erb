<div class="grid gap-6 md:grid-cols-2">
  <%= render Gustwave::Form::InlineField.new(class: "ps-4 border border-gray-200 rounded-sm dark:border-gray-700", row_options: { class: "items-center" }, text_options: { class: "w-full" }) do |field| %>
    <% field.with_control_radio(id: "bordered-radio-1", name: "bordered-radio", value: "") %>
    <% field.with_label("Assign to me", class: "block py-4") %>
  <% end %>

  <%= render Gustwave::Form::InlineField.new(class: "ps-4 border border-gray-200 rounded-sm dark:border-gray-700", row_options: { class: "items-center" }, text_options: { class: "w-full" }) do |field| %>
    <% field.with_control_radio(id: "bordered-radio-2", name: "bordered-radio", value: "", checked: true) %>
    <% field.with_label("Leave unassigned", class: "block py-4") %>
  <% end %>
</div>
