<%# The radios are one group, with purple checked. Blue is the default and Flowbite's example leaves it out. %>
<div class="flex flex-wrap">
  <% %i[red green purple teal yellow orange].each do |color| %>
    <%= render Gustwave::Form::InlineField.new(label: color.to_s.capitalize, class: "me-4") do |field| %>
      <% field.with_control_radio(id: "#{color}-radio", name: "colored-radio", value: color, checked: color == :purple, color: color) %>
    <% end %>
  <% end %>
</div>
