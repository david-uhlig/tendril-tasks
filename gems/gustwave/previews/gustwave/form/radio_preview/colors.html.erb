<%# Each radio has its own name, so each can be checked and its color shows. Blue is the default and Flowbite's example leaves it out. %>
<div class="flex flex-wrap">
  <% %i[red green purple teal yellow orange].each do |color| %>
    <%= render Gustwave::Form::InlineField.new(label: color.to_s.capitalize, class: "me-4") do |field| %>
      <% field.with_control_radio(id: "#{color}-radio", name: "colored-radio-#{color}", value: color, checked: true, color: color) %>
    <% end %>
  <% end %>
</div>
