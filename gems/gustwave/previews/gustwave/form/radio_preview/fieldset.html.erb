<%# Flowbite's forms page draws its radios with its own focus ring and without the checked color and the ring offset %>
<% own = "border-gray-300 focus:ring-blue-300 dark:focus:bg-blue-600" %>

<fieldset>
  <legend class="sr-only">Project visibility</legend>

  <%= render Gustwave::Form::InlineField.new(label: "Team", class: "mb-4") do |field| %>
    <% field.with_control_radio(id: "visibility-team", name: "visibility", value: "team", checked: true, class: own) %>
  <% end %>

  <%= render Gustwave::Form::InlineField.new(label: "Organization", class: "mb-4") do |field| %>
    <% field.with_control_radio(id: "visibility-organization", name: "visibility", value: "organization", class: own) %>
  <% end %>

  <%= render Gustwave::Form::InlineField.new(label: "Public", class: "mb-4") do |field| %>
    <% field.with_control_radio(id: "visibility-public", name: "visibility", value: "public", class: own) %>
  <% end %>

  <%# Flowbite draws the disabled radio of this example with a lighter border %>
  <%= render Gustwave::Form::InlineField.new(label: "Private (not available on your plan)") do |field| %>
    <% field.with_control_radio(id: "visibility-private", name: "visibility", value: "private", disabled: true, class: "border-gray-200 focus:ring-blue-300 dark:focus:ring-blue-600") %>
  <% end %>
</fieldset>
