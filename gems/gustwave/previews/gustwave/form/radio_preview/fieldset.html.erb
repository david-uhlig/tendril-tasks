<%# Flowbite's forms page draws its radios with its own focus ring and dark focus background, and its labels as blocks. The radios keep Form::Radio's blue and ring offset. %>
<% own = "focus:ring-blue-300 dark:focus:bg-blue-600" %>

<fieldset>
  <legend class="sr-only">Project visibility</legend>

  <%= render Gustwave::Form::InlineField.new(class: "mb-4") do |field| %>
    <% field.with_control_radio(id: "visibility-team", name: "visibility", value: "team", checked: true, class: own) %>
    <% field.with_label("Team", class: "block") %>
  <% end %>

  <%= render Gustwave::Form::InlineField.new(class: "mb-4") do |field| %>
    <% field.with_control_radio(id: "visibility-organization", name: "visibility", value: "organization", class: own) %>
    <% field.with_label("Organization", class: "block") %>
  <% end %>

  <%= render Gustwave::Form::InlineField.new(class: "mb-4") do |field| %>
    <% field.with_control_radio(id: "visibility-public", name: "visibility", value: "public", class: own) %>
    <% field.with_label("Public", class: "block") %>
  <% end %>

  <%= render Gustwave::Form::InlineField.new(class: "mb-4") do |field| %>
    <% field.with_control_radio(id: "visibility-internal", name: "visibility", value: "internal", class: own) %>
    <% field.with_label("Internal", class: "block") %>
  <% end %>

  <%# Flowbite draws the disabled radio of this example with a lighter border and its label lighter, too %>
  <%= render Gustwave::Form::InlineField.new do |field| %>
    <% field.with_control_radio(id: "visibility-private", name: "visibility", value: "private", disabled: true, class: "border-gray-200 focus:ring-blue-300 dark:focus:ring-blue-600") %>
    <% field.with_label("Private (not available on your plan)", class: "block text-gray-300 dark:text-gray-700") %>
  <% end %>
</fieldset>
