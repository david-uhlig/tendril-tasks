<%= render Gustwave::Form::InlineField.new(label: "Send me a daily digest", class: "mb-4") do |field| %>
  <% field.with_control_radio(id: "digest-daily", name: "digest", value: "", disabled: true) %>
<% end %>

<%= render Gustwave::Form::InlineField.new(label: "Send me a weekly digest") do |field| %>
  <% field.with_control_radio(id: "digest-weekly", name: "digest", value: "", checked: true, disabled: true) %>
<% end %>
