<%= render Gustwave::Form::Field.new(label: "Article body", validation: :success, class: "mb-6") do |field| %>
  <% field.with_control_rich_textarea(name: "article[body]", placeholder: "Write an article...") %>

  <% field.with_validation_message do %>
    <span class="font-medium">Well done!</span> Your article was saved.
  <% end %>
<% end %>

<%= render Gustwave::Form::Field.new(label: "Article body", validation: :error) do |field| %>
  <% field.with_control_rich_textarea(name: "article[body]", placeholder: "Write an article...") %>

  <% field.with_validation_message do %>
    <span class="font-medium">Oops!</span> Your article can't be empty.
  <% end %>
<% end %>
