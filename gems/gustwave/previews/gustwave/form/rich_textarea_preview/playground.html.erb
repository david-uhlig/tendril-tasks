<%= render Gustwave::Form::Field.new(label: "Article body", helper_text: "Change the options in the params panel.", validation: validation) do |field| %>
  <% field.with_control_rich_textarea(name: "article[body]", placeholder: "Write an article...", sticky_toolbar: sticky_toolbar) do |editor| %>
    <% if toolbar_place == :footer %>
      <% editor.with_footer_toolbar %>
    <% else %>
      <% editor.with_header_toolbar %>
    <% end %>
  <% end %>
<% end %>
