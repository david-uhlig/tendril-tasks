<form class="max-w-sm mx-auto">
  <%= render Gustwave::Form::Field.new(label: "Playground", helper_text: "Change the options in the params panel.", validation: validation) do |field| %>
    <% field.with_control_select(
         id: "playground-select",
         size: size,
         style: style,
         multiple: multiple,
         disabled: disabled,
         choices: [ [ "United States", "US" ], [ "Canada", "CA" ], [ "France", "FR" ], [ "Germany", "DE" ] ],
         prompt: ("Choose a country" unless multiple)
       ) %>
  <% end %>
</form>
