<form class="max-w-sm mx-auto">
  <%= render Gustwave::Form::Field.new(label: "Select an option") do |field| %>
    <%# The first option is selected, as in Flowbite, so the choices are option tags. %>
    <% field.with_control_select(
         id: "countries_multiple",
         multiple: true,
         choices: tag.option("Choose countries", selected: true) +
                  options_for_select([ [ "United States", "US" ], [ "Canada", "CA" ], [ "France", "FR" ], [ "Germany", "DE" ] ])
       ) %>
  <% end %>
</form>
