<% countries = [ [ "United States", "US" ], [ "Canada", "CA" ], [ "France", "FR" ], [ "Germany", "DE" ] ] %>

<form class="max-w-sm mx-auto">
  <%= render Gustwave::Form::Field.new(label: "Your country", validation: :success, class: "mb-6") do |field| %>
    <% field.with_control_select(id: "success", choices: countries, prompt: "Choose a country") %>

    <% field.with_validation_message do %>
      <span class="font-medium">Well done!</span> We deliver to that country.
    <% end %>
  <% end %>

  <%= render Gustwave::Form::Field.new(label: "Your country", validation: :error) do |field| %>
    <% field.with_control_select(id: "error", choices: countries, prompt: "Choose a country") %>

    <% field.with_validation_message do %>
      <span class="font-medium">Oops!</span> We don't deliver to that country.
    <% end %>
  <% end %>
</form>
