<% countries = [ [ "United States", "US" ], [ "Canada", "CA" ], [ "France", "FR" ], [ "Germany", "DE" ] ] %>

<form class="max-w-sm mx-auto">
  <%= render Gustwave::Form::Field.new(label: "Small select", class: "mb-6") do |field| %>
    <% field.with_control_select(id: "small", size: :sm, choices: countries, prompt: "Choose a country") %>
  <% end %>

  <%= render Gustwave::Form::Field.new(label: "Default select", class: "mb-6") do |field| %>
    <% field.with_control_select(id: "default", size: :md, choices: countries, prompt: "Choose a country") %>
  <% end %>

  <%= render Gustwave::Form::Field.new do |field| %>
    <% field.with_label("Large select", class: "text-base") %>
    <% field.with_control_select(id: "large", size: :lg, choices: countries, prompt: "Choose a country") %>
  <% end %>
</form>
