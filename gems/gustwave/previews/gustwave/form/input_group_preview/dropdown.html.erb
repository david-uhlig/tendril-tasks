<form>
  <%= render Gustwave::Form::Field.new do |field| %>
    <% field.with_label("Your search", for: "search-dropdown", class: "sr-only") %>

    <% field.with_control_input_group do |group| %>
      <% group.with_leading_addon_dropdown("All categories", menu_id: "dropdown-categories") do |dropdown| %>
        <% dropdown.with_menu_list do |menu| %>
          <% menu.with_item_link "Shopping", href: "#" %>
          <% menu.with_item_link "Images", href: "#" %>
          <% menu.with_item_link "News", href: "#" %>
          <% menu.with_item_link "Finance", href: "#" %>
        <% end %>
      <% end %>

      <% group.with_control_input(type: :search, id: "search-dropdown", placeholder: "Search") %>
    <% end %>
  <% end %>
</form>
