<div class="flex flex-wrap items-center gap-2">
  <%= render Gustwave::Button.new("Add") do |button| %>
    <% button.leading_icon :plus %>
  <% end %>

  <%= render Gustwave::Button.new("Next") do |button| %>
    <% button.trailing_icon :arrow_right %>
  <% end %>

  <%= render Gustwave::Button.new(scheme: :red, aria: { label: "Delete" }) do |button| %>
    <% button.leading_icon :trash_bin %>
  <% end %>
</div>
