<%= render Gustwave::Card.new do |card| %>
  <% card.with_image("/icon.png", alt: "Apple Watch Series 7", href: "#", class: "p-8") %>

  <%= render Gustwave::Link.new(href: "#", color: :none, class: "hover:no-underline") do %>
    <%= render Gustwave::Heading.new("Apple Watch Series 7 GPS, Aluminium Case, Starlight Sport", tag: :h5, size: :sm, class: "text-xl font-semibold tracking-tight text-gray-900 dark:text-white") %>
  <% end %>

  <%= render Gustwave::Rating.new(4, class: "mt-2.5 mb-5", empty_star_options: { class: "text-gray-200 dark:text-gray-600" }) do %>
    <%= render Gustwave::Badge.new("5.0", size: :xs, class: "ms-3 rounded-sm px-2.5 py-0.5 font-semibold dark:bg-blue-200 dark:text-blue-800") %>
  <% end %>

  <div class="flex items-center justify-between">
    <span class="text-3xl font-bold text-gray-900 dark:text-white">$599</span>
    <%= render Gustwave::Buttons::Default.new("Add to cart", tag: :a, href: "#") %>
  </div>
<% end %>
