<%= render Gustwave::Card.new(class: "w-full") do |card| %>
  <% card.configure_body(class: "p-0") %>

  <div class="flex justify-end px-4 pt-4">
    <%= render Gustwave::Dropdown.new do |dropdown| %>
      <% dropdown.with_trigger_generic(class: "flex") do %>
        <button
          type="button"
          aria-label="Open user menu"
          class="
            inline-block rounded-lg p-1.5 text-sm text-gray-500 hover:bg-gray-100 focus:ring-4 focus:outline-none
            focus:ring-gray-200 dark:text-gray-400 dark:hover:bg-gray-700 dark:focus:ring-gray-700
          "
        >
          <svg
            class="w-5 h-5"
            aria-hidden="true"
            xmlns="http://www.w3.org/2000/svg"
            fill="currentColor"
            viewBox="0 0 16 3"
          >
            <circle cx="2" cy="1.5" r="1.5" />
            <circle cx="8" cy="1.5" r="1.5" />
            <circle cx="14" cy="1.5" r="1.5" />
          </svg>
        </button>
      <% end %>

      <% dropdown.with_menu_list do |menu| %>
        <% menu.with_item_link "Edit", href: "#" %>
        <% menu.with_item_link "Export Data", href: "#" %>
        <% menu.with_item_link "Delete", href: "#", class: "text-red-600 dark:text-gray-200" %>
      <% end %>
    <% end %>
  </div>

  <div class="flex flex-col items-center pb-10">
    <%= render Gustwave::Avatar.new(src: "/icon.png", alt: "Jane Doe", size: :"2xl", class: "mb-3 h-24 w-24 shadow-lg") %>
    <%= render Gustwave::Heading.new("Jane Doe", tag: :h5, class: "mb-1 text-xl font-medium") %>

    <span class="text-sm text-gray-500 dark:text-gray-400">Visual designer</span>

    <div class="flex mt-4 md:mt-6">
      <%= render Gustwave::Buttons::Default.new("Add friend", tag: :a, href: "#", size: :sm, class: "px-4") %>
      <%= render Gustwave::Buttons::Default.new("Message", tag: :a, href: "#", size: :sm, color: :alternative, class: "ms-2 px-4") %>
    </div>
  </div>
<% end %>
