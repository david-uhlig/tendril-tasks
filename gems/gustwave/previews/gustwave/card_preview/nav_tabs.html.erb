<%= render Gustwave::Card.new(class: "w-full max-w-none", body_options: { class: "p-0" }) do %>
  <%= render Gustwave::Tabs.new(style: :none, list_options: { class: "rounded-t-lg border-b border-gray-200 bg-gray-50 text-gray-500 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-400 [&>li]:me-2" }, active_class: "text-blue-600 dark:bg-gray-800 dark:text-blue-500", inactive_class: "hover:text-gray-600 dark:hover:text-gray-300") do |tabs| %>
    <% tabs.with_tab_button("About", selected: true, class: "inline-block p-4 hover:bg-gray-100 dark:hover:bg-gray-700 rounded-ss-lg") do |tab| %>
      <% tab.with_panel(class: "bg-white md:p-8 dark:bg-gray-800") do %>
        <%= render Gustwave::Heading.new("Powering innovation and trust at 200,000+ companies worldwide", tag: :h2, class: "mb-3 text-3xl font-extrabold tracking-tight") %>
        <%= render Gustwave::Paragraph.new("Empower developers, IT operations and business teams to collaborate at high velocity. Respond to changes and deliver great customer and employee service experiences fast.", class: "mb-3") %>

        <%= render Gustwave::Link.new(href: "#", class: "inline-flex items-center hover:text-blue-800 hover:no-underline dark:hover:text-blue-700") do %>
          Learn more <%= render Gustwave::Icon.new(:chevron_right_compact, class: "w-2.5 h-2.5 ms-2") %>
        <% end %>
      <% end %>
    <% end %>

    <% tabs.with_tab_button("Services", class: "inline-block p-4 hover:bg-gray-100 dark:hover:bg-gray-700") do |tab| %>
      <% tab.with_panel(class: "bg-white md:p-8 dark:bg-gray-800") do %>
        <%= render Gustwave::Heading.new("What we offer for your team", tag: :h2, class: "mb-5 text-2xl font-extrabold tracking-tight") %>

        <ul role="list" class="space-y-4 text-gray-500 dark:text-gray-400">
          <li class="flex space-x-2 rtl:space-x-reverse items-center">
            <%= render Gustwave::Icon.new(:check_circle, theme: :solid, class: "shrink-0 w-3.5 h-3.5 text-blue-600 dark:text-blue-500") %>

            <span class="leading-tight">Live dashboards and reports</span>
          </li>

          <li class="flex space-x-2 rtl:space-x-reverse items-center">
            <%= render Gustwave::Icon.new(:check_circle, theme: :solid, class: "shrink-0 w-3.5 h-3.5 text-blue-600 dark:text-blue-500") %>

            <span class="leading-tight">Ready-made templates for everyone</span>
          </li>

          <li class="flex space-x-2 rtl:space-x-reverse items-center">
            <%= render Gustwave::Icon.new(:check_circle, theme: :solid, class: "shrink-0 w-3.5 h-3.5 text-blue-600 dark:text-blue-500") %>

            <span class="leading-tight">A development workflow that scales</span>
          </li>

          <li class="flex space-x-2 rtl:space-x-reverse items-center">
            <%= render Gustwave::Icon.new(:check_circle, theme: :solid, class: "shrink-0 w-3.5 h-3.5 text-blue-600 dark:text-blue-500") %>

            <span class="leading-tight">Automation without limits</span>
          </li>
        </ul>
      <% end %>
    <% end %>

    <% tabs.with_tab_button("Facts", class: "inline-block p-4 hover:bg-gray-100 dark:hover:bg-gray-700") do |tab| %>
      <% tab.with_panel(class: "bg-white md:p-8 dark:bg-gray-800") do %>
        <dl
          class="
            grid max-w-screen-xl grid-cols-2 gap-8 p-4 mx-auto text-gray-900 sm:grid-cols-3 xl:grid-cols-6
            dark:text-white sm:p-8
          "
        >
          <div class="flex flex-col">
            <dt class="mb-2 text-3xl font-extrabold">73M+</dt>
            <dd class="text-gray-500 dark:text-gray-400">Developers</dd>
          </div>

          <div class="flex flex-col">
            <dt class="mb-2 text-3xl font-extrabold">100M+</dt>
            <dd class="text-gray-500 dark:text-gray-400">Public repositories</dd>
          </div>

          <div class="flex flex-col">
            <dt class="mb-2 text-3xl font-extrabold">1000s</dt>
            <dd class="text-gray-500 dark:text-gray-400">Open source projects</dd>
          </div>
        </dl>
      <% end %>
    <% end %>
  <% end %>
<% end %>
