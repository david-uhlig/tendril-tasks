<%= render Gustwave::Card.new do %>
  <%= render Gustwave::Icon.new(:clipboard, theme: :solid, size: :lg, class: "mb-3 text-gray-500 dark:text-gray-400") %>

  <%= render Gustwave::Link.new(href: "#", color: :none) do %>
    <%= render Gustwave::Heading.new("Need help with a claim?", tag: :h5, size: :sm, class: "mb-2 font-semibold tracking-tight") %>
  <% end %>

  <%= render Gustwave::Paragraph.new("Follow this step by step guide to certify for your weekly benefits:", class: "mb-3") %>

  <%= render Gustwave::Link.new(href: "#", class: "inline-flex items-center dark:text-blue-600") do %>
    See our guide <%= render Gustwave::Icon.new(:arrow_up_right_from_square, theme: :solid, class: "w-3 h-3 ms-2.5") %>
  <% end %>
<% end %>
