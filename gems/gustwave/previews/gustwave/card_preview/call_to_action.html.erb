<%= render Gustwave::Card.new(class: "w-full max-w-none") do |card| %>
  <% card.configure_body(class: "p-4 text-center sm:p-8") %>

  <%= render Gustwave::Heading.new("Work fast from anywhere", tag: :h5, class: "mb-2 text-3xl font-bold") %>
  <%= render Gustwave::Paragraph.new("Stay on top of your tasks and keep projects moving with our apps for iOS and Android. Download it today.", class: "mb-5 text-base sm:text-lg") %>

  <div class="items-center justify-center space-y-4 sm:flex sm:space-y-0 sm:space-x-4 rtl:space-x-reverse">
    <%= render Gustwave::Buttons::Default.new(tag: :a, href: "#", color: :dark, class: "inline-flex w-full items-center justify-center px-4 py-2.5 sm:w-auto hover:bg-gray-700 dark:bg-gray-700 dark:hover:bg-gray-600") do %>
      <%= render Gustwave::Icon.new(:apple_full, theme: :solid, class: "me-3 h-7 w-7") %>

      <div class="text-left rtl:text-right">
        <div class="mb-1 text-xs">Download on the</div>
        <div class="-mt-1 font-sans text-sm font-semibold">App Store</div>
      </div>
    <% end %>

    <%= render Gustwave::Buttons::Default.new(tag: :a, href: "#", color: :dark, class: "inline-flex w-full items-center justify-center px-4 py-2.5 sm:w-auto hover:bg-gray-700 dark:bg-gray-700 dark:hover:bg-gray-600") do %>
      <%= render Gustwave::Icon.new(:google, theme: :solid, class: "me-3 h-7 w-7") %>

      <div class="text-left rtl:text-right">
        <div class="mb-1 text-xs">Get in on</div>
        <div class="-mt-1 font-sans text-sm font-semibold">Google Play</div>
      </div>
    <% end %>
  </div>
<% end %>
