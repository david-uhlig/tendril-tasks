<%= render Gustwave::Card.new(class: "w-full") do |card| %>
  <% card.configure_body(class: "p-4 sm:p-8") %>

  <%= render Gustwave::Heading.new("Standard plan", tag: :h5, class: "mb-4 text-xl font-medium text-gray-500 dark:text-gray-400") %>

  <div class="flex items-baseline text-gray-900 dark:text-white">
    <span class="text-3xl font-semibold">$</span>
    <span class="text-5xl font-extrabold tracking-tight">49</span>
    <span class="ms-1 text-xl font-normal text-gray-500 dark:text-gray-400">/month</span>
  </div>

  <ul role="list" class="space-y-5 my-7">
    <li class="flex items-center">
      <%= render Gustwave::Icon.new(:check_circle, theme: :solid, size: :xs, class: "shrink-0 w-4 h-4 text-blue-700 dark:text-blue-500") %>
      <span class="text-base font-normal leading-tight text-gray-500 dark:text-gray-400 ms-3">2 team members</span>
    </li>

    <li class="flex">
      <%= render Gustwave::Icon.new(:check_circle, theme: :solid, size: :xs, class: "shrink-0 w-4 h-4 text-blue-700 dark:text-blue-500") %>
      <span class="text-base font-normal leading-tight text-gray-500 dark:text-gray-400 ms-3">20GB Cloud storage</span>
    </li>

    <li class="flex">
      <%= render Gustwave::Icon.new(:check_circle, theme: :solid, size: :xs, class: "shrink-0 w-4 h-4 text-blue-700 dark:text-blue-500") %>
      <span class="text-base font-normal leading-tight text-gray-500 dark:text-gray-400 ms-3">Integration help</span>
    </li>

    <li class="flex line-through decoration-gray-500">
      <%= render Gustwave::Icon.new(:check_circle, theme: :solid, size: :xs, class: "shrink-0 w-4 h-4 text-gray-400 dark:text-gray-500") %>
      <span class="text-base font-normal leading-tight text-gray-500 ms-3">Sketch Files</span>
    </li>

    <li class="flex line-through decoration-gray-500">
      <%= render Gustwave::Icon.new(:check_circle, theme: :solid, size: :xs, class: "shrink-0 w-4 h-4 text-gray-400 dark:text-gray-500") %>
      <span class="text-base font-normal leading-tight text-gray-500 ms-3">API Access</span>
    </li>

    <li class="flex line-through decoration-gray-500">
      <%= render Gustwave::Icon.new(:check_circle, theme: :solid, size: :xs, class: "shrink-0 w-4 h-4 text-gray-400 dark:text-gray-500") %>
      <span class="text-base font-normal leading-tight text-gray-500 ms-3">Complete documentation</span>
    </li>

    <li class="flex line-through decoration-gray-500">
      <%= render Gustwave::Icon.new(:check_circle, theme: :solid, size: :xs, class: "shrink-0 w-4 h-4 text-gray-400 dark:text-gray-500") %>
      <span class="text-base font-normal leading-tight text-gray-500 ms-3">24×7 phone and email support</span>
    </li>
  </ul>

  <%= render Gustwave::Buttons::Default.new("Choose plan", class: "w-full justify-center") %>
<% end %>
