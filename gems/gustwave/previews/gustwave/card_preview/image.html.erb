<%= render Gustwave::Card.new do |card| %>
  <% card.with_image("/icon.png", alt: "Gustwave logo", href: "#") %>

  <%= render Gustwave::Link.new(href: "#", color: :none, class: "hover:no-underline") do %>
    <%= render Gustwave::Heading.new("Noteworthy technology acquisitions 2021", tag: :h5, size: :sm, class: "mb-2 tracking-tight") %>
  <% end %>

  <%= render Gustwave::Paragraph.new("Here are the biggest enterprise technology acquisitions of 2021.", class: "mb-3 font-normal text-gray-700 dark:text-gray-400") %>

  <%= render Gustwave::Buttons::Default.new("Read more", tag: :a, href: "#", size: :sm) do |button| %>
    <% button.with_trailing_visual_icon :arrow_right, class: "h-5 w-5 ms-0" %>
  <% end %>
<% end %>
