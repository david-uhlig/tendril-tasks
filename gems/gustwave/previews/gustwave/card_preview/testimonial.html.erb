<%= render Gustwave::Card.new(class: "mb-8 max-w-none shadow-xs md:mb-12") do |card| %>
  <% card.configure_body(class: "grid p-0 md:grid-cols-2") %>

  <figure
    class="
      flex flex-col items-center justify-center p-8 text-center bg-white border-b border-gray-200 rounded-t-lg
      md:rounded-t-none md:rounded-ss-lg md:border-e dark:bg-gray-800 dark:border-gray-700
    "
  >
    <blockquote class="max-w-2xl mx-auto mb-4 text-gray-500 lg:mb-8 dark:text-gray-400">
      <%= render Gustwave::Heading.new("Very easy to integrate", tag: :h3, class: "text-lg font-semibold") %>

      <p class="my-4">
        Our team had the whole kit running in an afternoon. If you care about your time, this is the one to pick.
      </p>
    </blockquote>

    <figcaption class="flex items-center justify-center">
      <%= render Gustwave::Avatar.new(src: "/icon.png", alt: "Bonnie Green", size: :sm, class: "h-9 w-9") %>

      <div class="space-y-0.5 font-medium dark:text-white text-left rtl:text-right ms-3">
        <div>Bonnie Green</div>
        <div class="text-sm text-gray-500 dark:text-gray-400">Developer at Open AI</div>
      </div>
    </figcaption>
  </figure>

  <figure
    class="
      flex flex-col items-center justify-center p-8 text-center bg-white border-b border-gray-200 md:rounded-se-lg
      dark:bg-gray-800 dark:border-gray-700
    "
  >
    <blockquote class="max-w-2xl mx-auto mb-4 text-gray-500 lg:mb-8 dark:text-gray-400">
      <%= render Gustwave::Heading.new("Solid foundation for any project", tag: :h3, class: "text-lg font-semibold") %>

      <p class="my-4">
        Designing with components that translate directly into utility classes is a huge timesaver for our design team.
      </p>
    </blockquote>

    <figcaption class="flex items-center justify-center">
      <%= render Gustwave::Avatar.new(src: "/icon.png", alt: "Roberta Casas", size: :sm, class: "h-9 w-9") %>

      <div class="space-y-0.5 font-medium dark:text-white text-left rtl:text-right ms-3">
        <div>Roberta Casas</div>
        <div class="text-sm text-gray-500 dark:text-gray-400">Lead designer at Dropbox</div>
      </div>
    </figcaption>
  </figure>

  <figure
    class="
      flex flex-col items-center justify-center p-8 text-center bg-white border-b border-gray-200 md:rounded-es-lg
      md:border-b-0 md:border-e dark:bg-gray-800 dark:border-gray-700
    "
  >
    <blockquote class="max-w-2xl mx-auto mb-4 text-gray-500 lg:mb-8 dark:text-gray-400">
      <%= render Gustwave::Heading.new("Mindblowing workflow", tag: :h3, class: "text-lg font-semibold") %>

      <p class="my-4">
        The well-designed components are beautiful and will undoubtedly level up the next application we build.
      </p>
    </blockquote>

    <figcaption class="flex items-center justify-center">
      <%= render Gustwave::Avatar.new(src: "/icon.png", alt: "Jese Leos", size: :sm, class: "h-9 w-9") %>

      <div class="space-y-0.5 font-medium dark:text-white text-left rtl:text-right ms-3">
        <div>Jese Leos</div>
        <div class="text-sm text-gray-500 dark:text-gray-400">Software Engineer at Facebook</div>
      </div>
    </figcaption>
  </figure>

  <figure
    class="
      flex flex-col items-center justify-center p-8 text-center bg-white border-gray-200 rounded-b-lg
      md:rounded-se-lg dark:bg-gray-800 dark:border-gray-700
    "
  >
    <blockquote class="max-w-2xl mx-auto mb-4 text-gray-500 lg:mb-8 dark:text-gray-400">
      <%= render Gustwave::Heading.new("Efficient collaborating", tag: :h3, class: "text-lg font-semibold") %>
      <p class="my-4">There are many examples we can reuse to build a fast prototype for the whole team.</p>
    </blockquote>

    <figcaption class="flex items-center justify-center">
      <%= render Gustwave::Avatar.new(src: "/icon.png", alt: "Joseph McFall", size: :sm, class: "h-9 w-9") %>

      <div class="space-y-0.5 font-medium dark:text-white text-left rtl:text-right ms-3">
        <div>Joseph McFall</div>
        <div class="text-sm text-gray-500 dark:text-gray-400">CTO at Google</div>
      </div>
    </figcaption>
  </figure>
<% end %>
