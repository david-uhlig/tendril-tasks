<div class="relative overflow-x-auto shadow-md sm:rounded-lg">
  <%= render Gustwave::Table.new(class: "text-blue-100 dark:text-blue-100") do |table| %>
    <% table.with_head(class: "text-white bg-blue-600 border-b border-blue-400 dark:text-white dark:bg-blue-600") do |head| %>
      <% head.with_column "Item", class: "bg-blue-500 dark:bg-blue-500" %>
      <% head.with_column "Location" %>
      <% head.with_column "Category", class: "bg-blue-500 dark:bg-blue-500" %>
      <% head.with_column "Amount" %>

      <% head.with_column "Action", class: "bg-blue-500 dark:bg-blue-500" %>
    <% end %>

    <% table.with_body do |body| %>
      <% rows.each_with_index do |supply, index| %>
        <% row_class = index == rows.size - 1 ? "bg-blue-600 dark:bg-blue-600 border-b-0 dark:border-blue-400" : "bg-blue-600 dark:bg-blue-600 border-b border-blue-400 dark:border-blue-400" %>

        <% body.with_row(class: row_class) do |row| %>
          <% row.with_cell_th supply[:item], class: "bg-blue-500 dark:bg-blue-500 text-blue-50 dark:text-blue-100" %>
          <% row.with_cell_td supply[:location] %>
          <% row.with_cell_td supply[:category], class: "bg-blue-500 dark:bg-blue-500" %>
          <% row.with_cell_td supply[:amount] %>

          <% row.with_cell_td class: "bg-blue-500 dark:bg-blue-500" do %>
            <%= render Gustwave::Link.new("Edit", href: "#", color: :none, class: "font-medium text-white hover:underline") %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
</div>
