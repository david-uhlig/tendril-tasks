<div class="relative overflow-x-auto shadow-md sm:rounded-lg">
  <%= render Gustwave::Table.new do |table| %>
    <% table.with_head do |head| %>
      <% head.with_column "Item" %>

      <% head.with_column do %>
        <div class="flex items-center">
          Location
          <%= render Gustwave::Link.new(href: "#", color: :none) do %>
            <%= render Gustwave::Icon.new(:sort, class: "w-3 h-3 ms-1.5") %>
          <% end %>
        </div>
      <% end %>

      <% head.with_column do %>
        <div class="flex items-center">
          Category
          <%= render Gustwave::Link.new(href: "#", color: :none) do %>
            <%= render Gustwave::Icon.new(:sort, class: "w-3 h-3 ms-1.5") %>
          <% end %>
        </div>
      <% end %>

      <% head.with_column do %>
        <div class="flex items-center">
          Amount
          <%= render Gustwave::Link.new(href: "#", color: :none) do %>
            <%= render Gustwave::Icon.new(:sort, class: "w-3 h-3 ms-1.5") %>
          <% end %>
        </div>
      <% end %>

      <% head.with_column do %>
        <span class="sr-only">Edit</span>
      <% end %>
    <% end %>

    <% table.with_body do |body| %>
      <% rows.each_with_index do |supply, index| %>
        <% body.with_row(class: ("border-b-0" if index == 2)) do |row| %>
          <% row.with_cell_th supply[:item] %>
          <% row.with_cell_td supply[:location] %>
          <% row.with_cell_td supply[:category] %>
          <% row.with_cell_td supply[:amount] %>

          <% row.with_cell_td class: "text-right" do %>
            <%= render Gustwave::Link.new("Edit", href: "#") %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
</div>
