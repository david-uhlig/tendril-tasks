<div class="relative overflow-x-auto shadow-md sm:rounded-lg">
  <%= render Gustwave::Table.new do |table| %>
    <% table.with_head do |head| %>
      <% head.with_column class: "p-4" do %>
        <div class="flex items-center">
          <%= render Gustwave::Form::Checkbox.new(id: "checkbox-all", aria: { label: "Select all" }) %>
        </div>
      <% end %>

      <% head.with_column "Item" %>
      <% head.with_column "Location" %>
      <% head.with_column "Category" %>
      <% head.with_column "Amount" %>
      <% head.with_column "Action" %>
    <% end %>

    <% table.with_body do |body| %>
      <% rows.each_with_index do |supply, index| %>
        <% row_class = index == rows.size - 1 ? "hover:bg-gray-50 dark:hover:bg-gray-600 border-b-0" : "hover:bg-gray-50 dark:hover:bg-gray-600" %>

        <% body.with_row class: row_class do |row| %>
          <% row.with_cell_td class: "w-4 p-4" do %>
            <div class="flex items-center">
              <%= render Gustwave::Form::Checkbox.new(id: "checkbox-table-#{index}", aria: { label: "Select row" }) %>
            </div>
          <% end %>

          <% row.with_cell_th supply[:item] %>
          <% row.with_cell_td supply[:location] %>
          <% row.with_cell_td supply[:category] %>
          <% row.with_cell_td supply[:amount] %>

          <% row.with_cell_td do %>
            <%= render Gustwave::Link.new("Edit", href: "#") %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
</div>
