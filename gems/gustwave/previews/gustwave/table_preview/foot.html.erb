<div class="relative overflow-x-auto">
  <%= render Gustwave::Table.new do |table| %>
    <% table.with_head(class: "bg-gray-100") do |head| %>
      <% head.with_column "Item", class: "rounded-s-lg" %>
      <% head.with_column "Amount" %>
      <% head.with_column "Weight", class: "rounded-e-lg" %>
    <% end %>

    <% table.with_body do |body| %>
      <% rows.each do |supply| %>
        <% body.with_row class: "border-b-0" do |row| %>
          <% row.with_cell_th supply[:item] %>
          <% row.with_cell_td supply[:amount] %>
          <% row.with_cell_td supply[:weight] %>
        <% end %>
      <% end %>
    <% end %>

    <% table.with_foot do |foot| %>
      <% foot.with_row do |row| %>
        <% row.with_cell_th "Total" %>
        <% row.with_cell_td "22 items" %>
        <% row.with_cell_td "13 kg" %>
      <% end %>
    <% end %>
  <% end %>
</div>
