<% radio_labels = [ "Last day", "Last 7 days", "Last 30 days", "Last month", "Last year" ] %>

<div class="relative overflow-x-auto shadow-md sm:rounded-lg">
  <div class="flex flex-column sm:flex-row flex-wrap space-y-4 sm:space-y-0 items-center justify-between pb-4">
    <div>
      <%= render Gustwave::Dropdown.new("Last 30 days", icon: :clock, color: :light, class: "text-gray-500 dark:text-white px-3 py-1.5") do |dropdown| %>
        <% dropdown.with_menu_generic class: "w-48 dark:divide-gray-600" do %>
          <ul class="p-3 space-y-1 text-sm text-gray-700 dark:text-gray-200">
            <% radio_labels.each_with_index do |label, index| %>
              <li>
                <div class="flex items-center p-2 rounded-sm hover:bg-gray-100 dark:hover:bg-gray-600">
                  <%= tag.input(
                    id: "filter-radio-example-#{index + 1}",
                    type: "radio",
                    value: "",
                    name: "filter-radio",
                    checked: index == 1,
                    class: "w-4 h-4 text-blue-600 bg-gray-100 border-gray-300 focus:ring-blue-500 dark:focus:ring-blue-600 dark:ring-offset-gray-800 dark:focus:ring-offset-gray-800 focus:ring-2 dark:bg-gray-700 dark:border-gray-600"
                  ) %>

                  <label
                    for="filter-radio-example-<%= index + 1 %>"
                    class="w-full ms-2 text-sm font-medium text-gray-900 rounded-sm dark:text-gray-300"
                  >
                    <%= label %>
                  </label>
                </div>
              </li>
            <% end %>
          </ul>
        <% end %>
      <% end %>
    </div>

    <label for="table-search" class="sr-only">Search</label>

    <div class="relative">
      <div class="absolute inset-y-0 left-0 rtl:inset-r-0 rtl:right-0 flex items-center ps-3 pointer-events-none">
        <%= render Gustwave::Icon.new(:search, theme: :solid, size: :sm, class: "text-gray-500 dark:text-gray-400") %>
      </div>

      <input
        type="text"
        id="table-search"
        class="
          block p-2 ps-10 text-sm text-gray-900 border border-gray-300 rounded-lg w-80 bg-gray-50
          focus:ring-blue-500 focus:border-blue-500 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400
          dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500
        "
        placeholder="Search for items"
      >
    </div>
  </div>

  <%= render Gustwave::Table.new do |table| %>
    <% table.with_head do |head| %>
      <% head.with_column class: "p-4" do %>
        <div class="flex items-center">
          <input
            id="checkbox-all-search"
            type="checkbox"
            class="
              w-4 h-4 text-blue-600 bg-gray-100 border-gray-300 rounded-sm focus:ring-blue-500
              dark:focus:ring-blue-600 dark:ring-offset-gray-800 dark:focus:ring-offset-gray-800 focus:ring-2
              dark:bg-gray-700 dark:border-gray-600
            "
          >

          <label for="checkbox-all-search" class="sr-only">checkbox</label>
        </div>
      <% end %>

      <% head.with_column "Item" %>
      <% head.with_column "Location" %>
      <% head.with_column "Category" %>
      <% head.with_column "Amount" %>
      <% head.with_column "Action" %>
    <% end %>

    <% table.with_body do |body| %>
      <% rows.each_with_index do |row, index| %>
        <% body.with_row class: (index == rows.size - 1 ? "border-b-0 hover:bg-gray-50 dark:hover:bg-gray-600" : "hover:bg-gray-50 dark:hover:bg-gray-600") do |tr| %>
          <% tr.with_cell_td class: "w-4 p-4" do %>
            <div class="flex items-center">
              <input
                id="checkbox-table-search-<%= index + 1 %>"
                type="checkbox"
                class="
                  w-4 h-4 text-blue-600 bg-gray-100 border-gray-300 rounded-sm focus:ring-blue-500
                  dark:focus:ring-blue-600 dark:ring-offset-gray-800 dark:focus:ring-offset-gray-800 focus:ring-2
                  dark:bg-gray-700 dark:border-gray-600
                "
              >

              <label for="checkbox-table-search-<%= index + 1 %>" class="sr-only">checkbox</label>
            </div>
          <% end %>

          <% tr.with_cell_th row[:item] %>
          <% tr.with_cell_td row[:location] %>
          <% tr.with_cell_td row[:category] %>
          <% tr.with_cell_td row[:amount] %>

          <% tr.with_cell_td class: "px-6 py-4" do %>
            <%= render Gustwave::Link.new("Edit", href: "#", class: "font-medium text-blue-600 dark:text-blue-500 hover:underline") %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
</div>
