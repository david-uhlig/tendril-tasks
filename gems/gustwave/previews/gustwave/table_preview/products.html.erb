<div class="relative overflow-x-auto shadow-md sm:rounded-lg">
  <%= render Gustwave::Table.new do |table| %>
    <% table.with_head do |head| %>
      <% head.with_column class: "px-16 py-3" do %>
        <span class="sr-only">Image</span>
      <% end %>

      <% head.with_column "Item" %>
      <% head.with_column "Qty" %>
      <% head.with_column "Amount" %>
      <% head.with_column "Action" %>
    <% end %>

    <% table.with_body do |body| %>
      <% rows.each_with_index do |row, index| %>
        <% body.with_row class: "hover:bg-gray-50 dark:hover:bg-gray-600" do |tr| %>
          <% tr.with_cell_td class: "p-4" do %>
            <img src="/icon.png" class="w-16 md:w-32 max-w-full max-h-full" alt="<%= row[:item] %>">
          <% end %>

          <% tr.with_cell_td row[:item], class: "font-semibold text-gray-900 dark:text-white" %>

          <% tr.with_cell_td do %>
            <div class="flex items-center">
              <button
                class="inline-flex items-center justify-center p-1 <%= 'me-3' if index.zero? %> text-sm font-medium h-6 w-6 text-gray-500 bg-white border border-gray-300 rounded-full focus:outline-none hover:bg-gray-100 focus:ring-4 focus:ring-gray-200 dark:bg-gray-800 dark:text-gray-400 dark:border-gray-600 dark:hover:bg-gray-700 dark:hover:border-gray-600 dark:focus:ring-gray-700"
                type="button"
              >
                <span class="sr-only">Quantity button</span>

                <svg
                  class="w-3 h-3"
                  aria-hidden="true"
                  xmlns="http://www.w3.org/2000/svg"
                  fill="none"
                  viewBox="0 0 18 2"
                >
                  <path
                    stroke="currentColor"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M1 1h16"
                  />
                </svg>
              </button>

              <div class="<%= 'ms-3' unless index.zero? %>">
                <input
                  type="number"
                  id="product-quantity-<%= index + 1 %>"
                  class="
                    bg-gray-50 w-14 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500
                    focus:border-blue-500 block px-2.5 py-1 dark:bg-gray-700 dark:border-gray-600
                    dark:placeholder-gray-400 dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500
                  "
                  placeholder="1"
                  required
                >
              </div>

              <button
                class="
                  inline-flex items-center justify-center h-6 w-6 p-1 ms-3 text-sm font-medium text-gray-500
                  bg-white border border-gray-300 rounded-full focus:outline-none hover:bg-gray-100 focus:ring-4
                  focus:ring-gray-200 dark:bg-gray-800 dark:text-gray-400 dark:border-gray-600
                  dark:hover:bg-gray-700 dark:hover:border-gray-600 dark:focus:ring-gray-700
                "
                type="button"
              >
                <span class="sr-only">Quantity button</span>

                <svg
                  class="w-3 h-3"
                  aria-hidden="true"
                  xmlns="http://www.w3.org/2000/svg"
                  fill="none"
                  viewBox="0 0 18 18"
                >
                  <path
                    stroke="currentColor"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M9 1v16M1 9h16"
                  />
                </svg>
              </button>
            </div>
          <% end %>

          <% tr.with_cell_td row[:amount], class: "font-semibold text-gray-900 dark:text-white" %>

          <% tr.with_cell_td do %>
            <%= render Gustwave::Link.new("Remove", href: "#", class: "font-medium text-red-600 dark:text-red-500 hover:underline") %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
</div>
