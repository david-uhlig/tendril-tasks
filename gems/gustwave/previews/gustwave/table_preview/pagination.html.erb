<div class="relative overflow-x-auto shadow-md sm:rounded-lg">
  <%= render Gustwave::Table.new do |table| %>
    <% table.with_head do |head| %>
      <% head.with_column class: "p-4" do %>
        <div class="flex items-center">
          <%= render Gustwave::Form::Checkbox.new(id: "checkbox-all-search", aria: { label: "Select all" }) %>
        </div>
      <% end %>

      <% head.with_column "Item" %>
      <% head.with_column "Location" %>
      <% head.with_column "Category" %>
      <% head.with_column "Amount" %>
      <% head.with_column "Action" %>
    <% end %>

    <% table.with_body do |body| %>
      <% rows.each_with_index do |supply, index| %>
        <% body.with_row class: "hover:bg-gray-50 dark:hover:bg-gray-600" do |row| %>
          <% row.with_cell_td class: "w-4 p-4" do %>
            <div class="flex items-center">
              <%= render Gustwave::Form::Checkbox.new(id: "checkbox-table-search-#{index}", aria: { label: "Select row" }) %>
            </div>
          <% end %>

          <% row.with_cell_th supply[:item] %>
          <% row.with_cell_td supply[:location] %>
          <% row.with_cell_td supply[:category] %>
          <% row.with_cell_td supply[:amount] %>

          <% row.with_cell_td do %>
            <%= render Gustwave::Link.new("Edit", href: "#") %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>

  <div class="flex items-center flex-column flex-wrap md:flex-row justify-between pt-4">
    <span class="text-sm font-normal text-gray-500 dark:text-gray-400 mb-4 md:mb-0 block w-full md:inline md:w-auto">Showing <span class="font-semibold text-gray-900 dark:text-white">1-10</span> of <span class="font-semibold text-gray-900 dark:text-white">1000</span></span>

    <%= render Gustwave::Pagination.new(aria: { label: "Table navigation" }) do |pagination| %>
      <% pagination.with_previous_page "Previous", href: "#" %>
      <% pagination.with_page "1", href: "#" %>
      <% pagination.with_page "2", href: "#" %>
      <% pagination.with_page "3", href: "#", active: true %>
      <% pagination.with_page "4", href: "#" %>
      <% pagination.with_page "5", href: "#" %>
      <% pagination.with_next_page "Next", href: "#" %>
    <% end %>
  </div>
</div>
