<div class="relative overflow-x-auto shadow-md sm:rounded-lg">
  <div
    class="
      flex items-center justify-between flex-column flex-wrap md:flex-row space-y-4 md:space-y-0 pb-4 bg-white
      dark:bg-gray-900
    "
  >
    <%= render Gustwave::Dropdown.new("Action", color: :light, class: "text-gray-500 dark:text-gray-400 px-3 py-1.5") do |dropdown| %>
      <% dropdown.with_menu_list class: "w-44 dark:divide-gray-600" do |menu| %>
        <% menu.with_item_link "Reward", href: "#" %>
        <% menu.with_item_link "Promote", href: "#" %>
        <% menu.with_item_link "Activate account", href: "#" %>

        <% menu.with_footer class: "px-0 py-1" do %>
          <a
            href="#example"
            class="
              block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 dark:hover:bg-gray-600 dark:text-gray-200
              dark:hover:text-white
            "
          >
            Delete User
          </a>
        <% end %>
      <% end %>
    <% end %>

    <label for="table-search-users" class="sr-only">Search</label>

    <div class="relative">
      <div class="absolute inset-y-0 rtl:inset-r-0 start-0 flex items-center ps-3 pointer-events-none">
        <%= render Gustwave::Icon.new(:search, size: :xs, class: "text-gray-500 dark:text-gray-400") %>
      </div>

      <input
        type="text"
        id="table-search-users"
        class="
          block p-2 ps-10 text-sm text-gray-900 border border-gray-300 rounded-lg w-80 bg-gray-50
          focus:ring-blue-500 focus:border-blue-500 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400
          dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500
        "
        placeholder="Search for users"
      >
    </div>
  </div>

  <%= render Gustwave::Table.new do |table| %>
    <% table.with_head do |head| %>
      <% head.with_column class: "p-4" do %>
        <div class="flex items-center">
          <input
            id="checkbox-all-search"
            type="checkbox"
            class="
              w-4 h-4 text-blue-600 bg-gray-100 border-gray-300 rounded-sm focus:ring-blue-500
              dark:focus:ring-blue-600 dark:ring-offset-gray-800 dark:focus:ring-offset-gray-800 focus:ring-2
              dark:bg-gray-700 dark:border-gray-600
            "
          >

          <label for="checkbox-all-search" class="sr-only">checkbox</label>
        </div>
      <% end %>

      <% head.with_column "Name" %>
      <% head.with_column "Position" %>
      <% head.with_column "Status" %>
      <% head.with_column "Action" %>
    <% end %>

    <% table.with_body do |body| %>
      <% people.each_with_index do |person, index| %>
        <% body.with_row class: (index == people.size - 1 ? "border-b-0 hover:bg-gray-50 dark:hover:bg-gray-600" : "hover:bg-gray-50 dark:hover:bg-gray-600") do |tr| %>
          <% tr.with_cell_td class: "w-4 p-4" do %>
            <div class="flex items-center">
              <input
                id="checkbox-table-search-<%= index + 1 %>"
                type="checkbox"
                class="
                  w-4 h-4 text-blue-600 bg-gray-100 border-gray-300 rounded-sm focus:ring-blue-500
                  dark:focus:ring-blue-600 dark:ring-offset-gray-800 dark:focus:ring-offset-gray-800 focus:ring-2
                  dark:bg-gray-700 dark:border-gray-600
                "
              >

              <label for="checkbox-table-search-<%= index + 1 %>" class="sr-only">checkbox</label>
            </div>
          <% end %>

          <% tr.with_cell_th class: "flex items-center px-6 py-4 font-medium text-gray-900 whitespace-nowrap dark:text-white" do %>
            <%= render Gustwave::Avatar.new(src: "/icon.png", alt: "#{person[:name]} avatar") %>

            <div class="ps-3">
              <div class="text-base font-semibold"><%= person[:name] %></div>
              <div class="font-normal text-gray-500"><%= person[:email] %></div>
            </div>
          <% end %>

          <% tr.with_cell_td person[:role] %>

          <% tr.with_cell_td class: "px-6 py-4" do %>
            <div class="flex items-center">
              <%= render Gustwave::Indicator.new(color: (person[:online] ? :green : :red), size: :xs, class: "h-2.5 w-2.5 me-2") %>
              <%= person[:online] ? "Online" : "Offline" %>
            </div>
          <% end %>

          <% tr.with_cell_td class: "px-6 py-4" do %>
            <%= render Gustwave::Link.new("Edit user", href: "#", class: "font-medium text-blue-600 dark:text-blue-500 hover:underline") %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
</div>
