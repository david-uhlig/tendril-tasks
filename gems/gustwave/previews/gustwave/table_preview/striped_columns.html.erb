<div class="relative overflow-x-auto shadow-md sm:rounded-lg">
  <%= render Gustwave::Table.new do |table| %>
    <% table.with_head class: "bg-transparent dark:bg-transparent" do |head| %>
      <% head.with_column "Item", class: "bg-gray-50 dark:bg-gray-800" %>
      <% head.with_column "Location" %>
      <% head.with_column "Category", class: "bg-gray-50 dark:bg-gray-800" %>
      <% head.with_column "Amount" %>
    <% end %>

    <% table.with_body do |body| %>
      <% rows.each_with_index do |row_data, index| %>
        <% row_class = index == rows.size - 1 ? "bg-transparent dark:bg-transparent border-b-0" : "bg-transparent dark:bg-transparent" %>

        <% body.with_row class: row_class do |row| %>
          <% row.with_cell_th row_data[:item], class: "bg-gray-50 dark:bg-gray-800" %>
          <% row.with_cell_td row_data[:location] %>
          <% row.with_cell_td row_data[:category], class: "bg-gray-50 dark:bg-gray-800" %>
          <% row.with_cell_td row_data[:amount] %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
</div>
