<%= tag.div **@options do %>
  <% if visuals? %>
    <%= tag.div class: classes(:visual_box) do %>
      <%= safe_join(visuals) %>
      <%= tag.span status_label, class: "sr-only" if status_label %>
    <% end %>
    <%= tag.div text_or_content(text), class: classes(:message) %>
  <% else %>
    <%= text_or_content(text) %>
  <% end %>

  <%= dismiss_button if dismissible? && !@dismiss_button_rendered %>
<% end %>
